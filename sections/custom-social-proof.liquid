{%- comment -%}
  "Real routines. Real people." — four testimonial cards on the espresso texture.

  Comp: y3430-4030 (600px). Headline left, rating cluster right ("4.8 from 150+
  beta testers"), then four cards each with a circular headshot overlapping the
  card's top edge, name, tenure, five stars and a quote.

  Testimonials are advertising claims: the names, tenures and rating shown here
  come from the comp and need substantiation on file.
{%- endcomment -%}

<section class="fg-proof">
  <div class="fg-proof__inner">

    <div class="fg-proof__head">
      <h2 class="fg-proof__title">
        <span>{{ section.settings.title_a }}</span>
        <span class="fg-proof__title-b">{{ section.settings.title_b }}</span>
      </h2>
      <div class="fg-proof__rating">
        <p class="fg-proof__rating-eyebrow"><span></span>{{ section.settings.rating_eyebrow }}<span></span></p>
        <p class="fg-proof__rating-row">
          {%- render 'fg-icon', name: 'stars' -%}
          <strong>{{ section.settings.rating_score }}</strong>
          <span>{{ section.settings.rating_note }}</span>
        </p>
      </div>
    </div>

    <ul class="fg-proof__grid">
      {%- for block in section.blocks -%}
        <li class="fg-quote" {{ block.shopify_attributes }}>
          <div class="fg-quote__avatar">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 334 }}"
                   alt="{{ block.settings.name | escape }}" width="112" height="112" loading="lazy">
            {%- elsif block.settings.fallback_image != blank -%}
              <img src="{{ block.settings.fallback_image | asset_url }}"
                   alt="{{ block.settings.name | escape }}" width="112" height="112" loading="lazy">
            {%- endif -%}
          </div>
          <p class="fg-quote__name">{{ block.settings.name }}</p>
          <p class="fg-quote__meta">{{ block.settings.meta }}</p>
          <span class="fg-quote__stars">{%- render 'fg-icon', name: 'stars' -%}</span>
          <blockquote class="fg-quote__text">{{ block.settings.quote }}</blockquote>
        </li>
      {%- endfor -%}
    </ul>

  </div>
</section>

<style>
  .fg-proof {
    background-color: var(--fg-ink);
    background-image: url('{{ 'fg-texture-espresso.jpg' | asset_url }}');
    background-size: cover;
    background-position: center;
    color: var(--fg-on-dark);
  }
  .fg-proof__inner {
    max-width: 1000px;
    margin-inline: auto;
    padding: 44px var(--container-pad) 52px;
  }

  .fg-proof__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    flex-wrap: wrap;
    margin-bottom: 46px;
  }
  .fg-proof__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(22px, 2.3vw, 34px);
    font-weight: 800;
    letter-spacing: var(--track-display);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--fg-cream);
  }
  .fg-proof__title span { margin-right: 12px; }
  .fg-proof__title-b { color: var(--fg-caramel); }

  .fg-proof__rating { text-align: right; }
  .fg-proof__rating-eyebrow {
    display: flex; align-items: center; gap: 10px; justify-content: flex-end;
    margin: 0 0 6px;
    font-family: var(--font-body); font-size: 11px; font-weight: var(--fg-w-bold);
    letter-spacing: var(--track-label); text-transform: uppercase;
    color: var(--fg-on-dark-dim);
  }
  .fg-proof__rating-eyebrow span { width: 26px; height: 1px; background: var(--fg-rule-dark); }
  .fg-proof__rating-row {
    display: flex; align-items: center; justify-content: flex-end; gap: 9px;
    margin: 0; font-family: var(--font-body); font-size: 13px; color: var(--fg-on-dark-dim);
  }
  .fg-proof__rating-row .fg-i { width: 92px; height: 17px; color: var(--fg-caramel); }
  .fg-proof__rating-row strong {
    font-family: var(--font-display); font-size: 26px; font-weight: 800;
    color: var(--fg-cream); line-height: 1;
  }

  .fg-proof__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fg-quote {
    position: relative;
    margin-top: 56px;
    padding: 68px 16px 24px;
    border: 1px solid var(--fg-rule-dark);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  /* The headshot straddles the card's top edge, as drawn in the comp. */
  .fg-quote__avatar {
    position: absolute;
    top: -56px;
    left: 50%;
    transform: translateX(-50%);
    width: 112px;
    height: 112px;
  }
  .fg-quote__avatar img {
    width: 112px; height: 112px; border-radius: 50%; object-fit: cover; display: block;
  }
  .fg-quote__name,
  .fg-quote__meta { margin: 0; font-family: var(--font-body); line-height: 1.3; }
  .fg-quote__name { font-size: 16px; font-weight: 700; color: var(--fg-cream); }
  /* Two lines reserved so a longer tenure line does not drop one card's
     stars and quote out of line with the rest. */
  .fg-quote__meta { margin-top: 3px; min-height: 2.6em; font-size: 11px; color: var(--fg-on-dark-dim); }
  .fg-quote__stars { display: block; margin: 10px auto 12px; width: 84px; color: var(--fg-caramel); }
  .fg-quote__stars .fg-i { width: 84px; height: 15px; }
  .fg-quote__text {
    margin: 0;
    font-style: normal;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--fg-on-dark-dim);
  }

  @media (max-width: 900px) {
    .fg-proof__grid { grid-template-columns: repeat(2, 1fr); gap: 16px 14px; }
    .fg-proof__head { margin-bottom: 34px; }
    .fg-proof__rating, .fg-proof__rating-eyebrow, .fg-proof__rating-row { text-align: left; justify-content: flex-start; }
  }
  @media (max-width: 560px) {
    /* One card at a time, swiped — four stacked cards would run very long. */
    .fg-proof__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 78%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 10px;
      margin-inline: calc(var(--container-pad) * -1);
      padding-inline: var(--container-pad);
    }
    .fg-quote { scroll-snap-align: center; }
  }
</style>

{% schema %}
{
  "name": "FlushGut Testimonials",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "title_a", "label": "Headline part 1", "default": "Real Routines." },
    { "type": "text", "id": "title_b", "label": "Headline part 2", "default": "Real People." },
    { "type": "text", "id": "rating_eyebrow", "label": "Rating eyebrow", "default": "Real Words From Real Testers" },
    { "type": "text", "id": "rating_score", "label": "Score", "default": "4.8" },
    { "type": "text", "id": "rating_note", "label": "Score note", "default": "from 150+ beta testers" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Headshot" },
        { "type": "text", "id": "fallback_image", "label": "Theme asset fallback", "info": "e.g. fg-tester-aria.webp" },
        { "type": "text", "id": "name", "label": "Name", "default": "Aria M." },
        { "type": "text", "id": "meta", "label": "Meta", "default": "Verified beta tester — Daily Routine" },
        { "type": "textarea", "id": "quote", "label": "Quote" }
      ]
    }
  ],
  "presets": [{ "name": "FlushGut Testimonials" }]
}
{% endschema %}
