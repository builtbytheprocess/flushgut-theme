{% comment %} FlushGut high-converting cart drawer {% endcomment %}

{%- liquid
  assign free_threshold = 50
  assign cart_dollars = cart.total_price | divided_by: 100.0
  assign shipping_remaining = free_threshold | minus: cart_dollars
  assign shipping_pct = cart_dollars | divided_by: free_threshold | times: 100 | at_most: 100
  assign has_sub = false
  assign has_orange = false
  assign has_berry = false
  for item in cart.items
    if item.selling_plan_allocation
      assign has_sub = true
    endif
    if item.product.handle == 'flushgut-orange'
      assign has_orange = true
    endif
    if item.product.handle == 'flushgut-berry'
      assign has_berry = true
    endif
  endfor
  assign orange_product = all_products['flushgut-orange']
  assign berry_product = all_products['flushgut-berry']
-%}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

<style>
/* ── FlushGut Cart Drawer ── */
.fg-cart-panel { display:flex; flex-direction:column; height:100%; background:#fff; width:min(420px,100vw); }

/* Header */
.fg-cart-hdr { background:var(--fg-dark); padding:16px 20px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }
.fg-cart-hdr__title { font-family:var(--font-body); font-size:14px; font-weight:700; color:#fff; display:flex; align-items:center; gap:8px; }
.fg-cart-hdr__count { background:var(--fg-orange); color:#fff; font-size:11px; font-weight:800; padding:2px 8px; border-radius:100px; }
.fg-cart-close { background:none; border:none; cursor:pointer; color:rgba(255,255,255,0.6); font-size:20px; line-height:1; padding:0; transition:color 150ms; }
.fg-cart-close:hover { color:#fff; }

/* Scrollable body */
.fg-cart-body { flex:1; overflow-y:auto; }

/* Shipping bar */
.fg-cart-ship { padding:12px 20px; background:#f8f9fa; border-bottom:1px solid #eee; }
.fg-cart-ship__text { font-family:var(--font-body); font-size:12px; font-weight:600; color:var(--fg-ink); margin-bottom:6px; }
.fg-cart-ship__text span { color:var(--fg-orange); }
.fg-cart-ship__track { height:5px; background:#e0e0e0; border-radius:3px; overflow:hidden; }
.fg-cart-ship__fill { height:100%; background:linear-gradient(90deg,var(--fg-orange),var(--fg-orange-hot)); border-radius:3px; transition:width 0.4s ease; }

/* Urgency timer */
.fg-cart-urgency { background:var(--fg-dark); padding:10px 20px; display:flex; align-items:center; justify-content:space-between; gap:8px; }
.fg-cart-urgency__text { font-family:var(--font-body); font-size:12px; font-weight:600; color:#fff; display:flex; align-items:center; gap:6px; }
.fg-cart-urgency__timer { background:var(--fg-orange); color:#fff; font-family:var(--font-body); font-size:13px; font-weight:800; padding:2px 8px; border-radius:4px; letter-spacing:0.04em; }

/* Cart items */
.fg-cart-items { padding:8px 0; }
.fg-cart-item { display:grid; grid-template-columns:72px 1fr auto; gap:12px; align-items:start; padding:16px 20px; border-bottom:1px solid #f0f0f0; }
.fg-cart-item__img { width:72px; height:72px; border-radius:8px; overflow:hidden; background:#f5f5f5; }
.fg-cart-item__img img { width:100%; height:100%; object-fit:cover; display:block; }
.fg-cart-item__name { font-family:var(--font-body); font-size:14px; font-weight:700; color:var(--fg-ink); text-decoration:none; display:block; margin-bottom:2px; }
.fg-cart-item__name:hover { color:var(--fg-orange); }
.fg-cart-item__variant { font-size:12px; color:var(--fg-muted); margin-bottom:4px; }
.fg-cart-item__plan { font-size:11px; color:var(--fg-orange); font-weight:600; margin-bottom:8px; }
.fg-cart-item__qty { display:flex; align-items:center; gap:0; }
.fg-cart-item__qty .quantity { border:1px solid #e0e0e0; border-radius:8px; display:flex; align-items:center; overflow:hidden; }
.fg-cart-item__qty .quantity__button { background:none; border:none; padding:4px 10px; cursor:pointer; color:var(--fg-ink); font-size:16px; line-height:1; transition:background 150ms; }
.fg-cart-item__qty .quantity__button:hover { background:#f5f5f5; }
.fg-cart-item__qty .quantity__input { border:none; width:36px; text-align:center; font-family:var(--font-body); font-size:14px; font-weight:600; background:none; -moz-appearance:textfield; padding:4px 0; }
.fg-cart-item__qty .quantity__input::-webkit-outer-spin-button,
.fg-cart-item__qty .quantity__input::-webkit-inner-spin-button { -webkit-appearance:none; }
.fg-cart-item__price { text-align:right; }
.fg-cart-item__price-now { font-family:var(--font-body); font-size:16px; font-weight:800; color:var(--fg-ink); }
.fg-cart-item__price-was { font-size:11px; color:#bbb; text-decoration:line-through; }
.fg-cart-item__remove { display:block; margin-top:6px; font-size:10px; color:#ccc; cursor:pointer; background:none; border:none; padding:0; font-family:var(--font-body); text-decoration:underline; }
.fg-cart-item__remove:hover { color:var(--fg-muted); }

/* Cross-sell */
.fg-cart-xsell { margin:0 20px 4px; background:#faf8f5; border:1px solid var(--fg-border); border-radius:12px; padding:14px; display:flex; align-items:center; gap:12px; }
.fg-cart-xsell__img { width:52px; height:52px; border-radius:8px; overflow:hidden; flex-shrink:0; }
.fg-cart-xsell__img img { width:100%; height:100%; object-fit:cover; }
.fg-cart-xsell__body { flex:1; min-width:0; }
.fg-cart-xsell__label { font-size:10px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:var(--fg-orange); margin-bottom:2px; }
.fg-cart-xsell__name { font-size:13px; font-weight:700; color:var(--fg-ink); margin-bottom:2px; }
.fg-cart-xsell__price { font-size:12px; color:var(--fg-muted); }
.fg-cart-xsell__btn { background:var(--fg-orange); color:#fff; border:none; border-radius:100px; padding:8px 16px; font-family:var(--font-body); font-size:12px; font-weight:700; cursor:pointer; flex-shrink:0; transition:background 150ms; }
.fg-cart-xsell__btn:hover { background:var(--fg-orange-hot); }

/* Footer */
.fg-cart-foot { padding:16px 20px; border-top:1px solid #eee; background:#fff; flex-shrink:0; }
.fg-cart-totals { margin-bottom:12px; }
.fg-cart-totals__row { display:flex; justify-content:space-between; align-items:center; margin-bottom:4px; }
.fg-cart-totals__label { font-family:var(--font-body); font-size:13px; color:var(--fg-muted); }
.fg-cart-totals__value { font-family:var(--font-body); font-size:13px; color:var(--fg-ink); font-weight:600; }
.fg-cart-totals__total-label { font-family:var(--font-body); font-size:16px; font-weight:700; color:var(--fg-ink); }
.fg-cart-totals__total-value { font-family:var(--font-body); font-size:18px; font-weight:900; color:var(--fg-ink); }
.fg-cart-totals__savings { color:#22c55e; font-weight:700; }
.fg-cart-checkout { width:100%; background:var(--fg-orange); color:#fff; border:none; border-radius:100px; padding:16px; font-family:var(--font-body); font-size:15px; font-weight:900; letter-spacing:0.04em; text-transform:uppercase; cursor:pointer; box-shadow:var(--shadow-cta); transition:background 150ms, transform 150ms; margin-bottom:8px; display:flex; align-items:center; justify-content:center; gap:8px; }
.fg-cart-checkout:hover { background:var(--fg-orange-hot); transform:translateY(-1px); }
.fg-cart-checkout:disabled { opacity:0.5; cursor:not-allowed; transform:none; }
.fg-cart-tax { font-family:var(--font-body); font-size:11px; color:var(--fg-muted); text-align:center; margin-bottom:10px; }
.fg-cart-trust { display:flex; justify-content:center; gap:16px; }
.fg-cart-trust__item { font-family:var(--font-body); font-size:10px; font-weight:600; color:var(--fg-muted); text-transform:uppercase; letter-spacing:0.06em; }
.fg-cart-continue { display:block; text-align:center; margin-top:10px; font-family:var(--font-body); font-size:12px; color:var(--fg-muted); text-decoration:underline; cursor:pointer; background:none; border:none; width:100%; }

/* Empty state */
.fg-cart-empty { padding:40px 20px; text-align:center; }
.fg-cart-empty__title { font-family:var(--font-body); font-size:18px; font-weight:700; color:var(--fg-ink); margin-bottom:8px; }
.fg-cart-empty__sub { font-size:14px; color:var(--fg-muted); margin-bottom:24px; }
.fg-cart-empty__btn { display:inline-block; background:var(--fg-orange); color:#fff; padding:12px 28px; border-radius:100px; font-family:var(--font-body); font-size:14px; font-weight:700; text-decoration:none; }

/* Let Dawn handle ALL drawer animation — only style the panel contents */
.fg-cart-panel { display:flex; flex-direction:column; height:100%; background:#fff; }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>

    <div class="drawer__inner fg-cart-panel" role="dialog" aria-modal="true" aria-label="Your cart" tabindex="-1">

      <!-- HEADER -->
      <div class="fg-cart-hdr">
        <div class="fg-cart-hdr__title">
          {%- if cart != empty -%}
            Added to Your Routine!
            <span class="fg-cart-hdr__count">{{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}</span>
          {%- else -%}
            Your Cart
          {%- endif -%}
        </div>
        <button class="fg-cart-close drawer__close" type="button" onclick="this.closest('cart-drawer').close()" aria-label="Close cart">&#10005;</button>
      </div>

      <div class="fg-cart-body">
        <cart-drawer-items{% if cart == empty %} class="is-empty"{% endif %}>
          <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart__contents" method="post">

            {%- if cart != empty -%}

              <!-- FREE SHIPPING BAR -->
              <div class="fg-cart-ship">
                <div class="fg-cart-ship__text">
                  {%- if cart_dollars >= free_threshold -%}
                    🎉 You've unlocked <span>free shipping!</span>
                  {%- else -%}
                    Only <span>${{ shipping_remaining | round: 2 }}</span> away from <span>Free Shipping</span>
                  {%- endif -%}
                </div>
                <div class="fg-cart-ship__track">
                  <div class="fg-cart-ship__fill" style="width:{{ shipping_pct }}%;"></div>
                </div>
              </div>

              <!-- URGENCY TIMER (subscriptions only) -->
              {%- if has_sub -%}
              <div class="fg-cart-urgency">
                <div class="fg-cart-urgency__text">
                  <span>🔥</span>
                  Your 30% subscription discount — expires in
                </div>
                <span class="fg-cart-urgency__timer" id="fg-cart-timer">10:00</span>
              </div>
              {%- endif -%}

            {%- endif -%}

            <!-- CART ITEMS -->
            <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
              {%- if cart != empty -%}
                <div class="fg-cart-items">
                  {%- for item in cart.items -%}
                    <div id="CartDrawer-Item-{{ item.index | plus: 1 }}" class="fg-cart-item cart-item">
                      <!-- Image -->
                      <div class="fg-cart-item__img">
                        {%- if item.image -%}
                          <a href="{{ item.url }}" tabindex="-1">
                            <img src="{{ item.image | image_url: width: 144 }}" alt="{{ item.image.alt | escape }}" width="72" height="72" loading="lazy">
                          </a>
                        {%- endif -%}
                      </div>

                      <!-- Details -->
                      <div>
                        <a href="{{ item.url }}" class="fg-cart-item__name">{{ item.product.title | escape }}</a>
                        {%- unless item.product.has_only_default_variant -%}
                          <div class="fg-cart-item__variant">
                            {%- for option in item.options_with_values -%}{{ option.value }}{%- unless forloop.last %} / {% endunless %}{%- endfor -%}
                          </div>
                        {%- endunless -%}
                        {%- if item.selling_plan_allocation -%}
                          <div class="fg-cart-item__plan">{{ item.selling_plan_allocation.selling_plan.name }} · Cancel anytime</div>
                        {%- endif -%}

                        <!-- Qty -->
                        <div class="fg-cart-item__qty">
                          <quantity-input class="quantity cart-quantity">
                            <button class="quantity__button" name="minus" type="button">
                              <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}</span>
                              <span>&#8722;</span>
                            </button>
                            <input class="quantity__input" type="number" data-quantity-variant-id="{{ item.variant.id }}" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}" id="Drawer_Quantity-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                            <button class="quantity__button" name="plus" type="button">
                              <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}</span>
                              <span>&#43;</span>
                            </button>
                          </quantity-input>
                        </div>

                        <cart-remove-button id="CartDrawer-Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                          <button type="button" class="fg-cart-item__remove cart-remove-button" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}" data-variant-id="{{ item.variant.id }}">Remove</button>
                        </cart-remove-button>
                      </div>

                      <!-- Price -->
                      <div class="fg-cart-item__price">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <div class="fg-cart-item__price-was">{{ item.original_line_price | money }}</div>
                          <div class="fg-cart-item__price-now">{{ item.final_line_price | money }}</div>
                        {%- else -%}
                          <div class="fg-cart-item__price-now">{{ item.original_line_price | money }}</div>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>

                <!-- CROSS-SELL: OTHER FLAVOR -->
                {%- if has_orange and has_berry == false -%}
                  <div class="fg-cart-xsell">
                    <div class="fg-cart-xsell__img">
                      <img src="{{ berry_product.featured_image | image_url: width: 104 }}" alt="FlushGut Berry" width="52" height="52" loading="lazy">
                    </div>
                    <div class="fg-cart-xsell__body">
                      <div class="fg-cart-xsell__label">Try the other flavor</div>
                      <div class="fg-cart-xsell__name">FlushGut Berry</div>
                      <div class="fg-cart-xsell__price">From $27.99/box</div>
                    </div>
                    <button type="button" class="fg-cart-xsell__btn" onclick="fgAddFlavor('{{ berry_product.variants.first.id }}')">Add</button>
                  </div>
                {%- elsif has_berry and has_orange == false -%}
                  <div class="fg-cart-xsell">
                    <div class="fg-cart-xsell__img">
                      <img src="{{ orange_product.featured_image | image_url: width: 104 }}" alt="FlushGut Orange" width="52" height="52" loading="lazy">
                    </div>
                    <div class="fg-cart-xsell__body">
                      <div class="fg-cart-xsell__label">Try the other flavor</div>
                      <div class="fg-cart-xsell__name">FlushGut Orange</div>
                      <div class="fg-cart-xsell__price">From $27.99/box</div>
                    </div>
                    <button type="button" class="fg-cart-xsell__btn" onclick="fgAddFlavor('{{ orange_product.variants.first.id }}')">Add</button>
                  </div>
                {%- endif -%}

              {%- else -%}
                <div class="fg-cart-empty">
                  <div class="fg-cart-empty__title">Your routine awaits</div>
                  <div class="fg-cart-empty__sub">Add FlushGut to start feeling lighter and more regular — once a week.*</div>
                  <a href="{{ routes.all_products_collection_url }}" class="fg-cart-empty__btn" onclick="this.closest('cart-drawer').close()">Shop Now</a>
                </div>
              {%- endif -%}

              <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
              <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">{{ 'accessibility.loading' | t }}</p>
            </div>

            <div id="CartDrawer-CartErrors" role="alert"></div>
          </form>
        </cart-drawer-items>
      </div>

      <!-- FOOTER -->
      {%- if cart != empty -%}
      <div class="drawer__footer fg-cart-foot">

        <!-- Totals -->
        <div class="fg-cart-totals" role="status">
          {%- assign total_savings = 0 -%}
          {%- for item in cart.items -%}
            {%- assign savings = item.original_line_price | minus: item.final_line_price -%}
            {%- assign total_savings = total_savings | plus: savings -%}
          {%- endfor -%}
          {%- if total_savings > 0 -%}
            <div class="fg-cart-totals__row">
              <span class="fg-cart-totals__label">You save</span>
              <span class="fg-cart-totals__value fg-cart-totals__savings">-{{ total_savings | money }}</span>
            </div>
          {%- endif -%}
          <div class="fg-cart-totals__row">
            <span class="fg-cart-totals__total-label">Total</span>
            <span class="fg-cart-totals__total-value">{{ cart.total_price | money }}</span>
          </div>
        </div>

        <!-- Checkout -->
        <button type="submit" id="CartDrawer-Checkout" class="fg-cart-checkout" name="checkout" form="CartDrawer-Form">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Proceed to Checkout &rarr;
        </button>

        <p class="fg-cart-tax">Savings &amp; taxes calculated at checkout</p>

        <div class="fg-cart-trust">
          <span class="fg-cart-trust__item">&#10003; Cancel anytime</span>
          <span class="fg-cart-trust__item">&#10003; 60-day guarantee</span>
          <span class="fg-cart-trust__item">&#10003; Secure</span>
        </div>

        <button type="button" class="fg-cart-continue" onclick="this.closest('cart-drawer').close()">Continue Shopping</button>
      </div>
      {%- endif -%}

    </div>
  </div>
</cart-drawer>

<script>
(function(){
  // Urgency countdown timer
  function startTimer() {
    var el = document.getElementById('fg-cart-timer');
    if (!el) return;
    var key = 'fg_cart_timer_end';
    var end = sessionStorage.getItem(key);
    if (!end) {
      end = Date.now() + 10 * 60 * 1000;
      sessionStorage.setItem(key, end);
    }
    end = parseInt(end, 10);
    function tick() {
      var remaining = Math.max(0, end - Date.now());
      var m = Math.floor(remaining / 60000);
      var s = Math.floor((remaining % 60000) / 1000);
      el.textContent = m + ':' + (s < 10 ? '0' : '') + s;
      if (remaining > 0) setTimeout(tick, 1000);
      else el.textContent = '0:00';
    }
    tick();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startTimer);
  } else {
    startTimer();
  }
})();

// Cross-sell add flavor
function fgAddFlavor(variantId) {
  var btn = event.currentTarget;
  btn.textContent = 'Adding...';
  btn.disabled = true;
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify({ items: [{ id: parseInt(variantId, 10), quantity: 1 }] })
  })
  .then(function(r) { return r.json(); })
  .then(function() { window.location.reload(); })
  .catch(function() { btn.textContent = 'Add'; btn.disabled = false; });
}
</script>
