{% liquid
  assign plan_5wk  = section.settings.selling_plan_5wk
  assign plan_11wk = section.settings.selling_plan_11wk
  assign orange = all_products['flushgut-orange']
  assign berry  = all_products['flushgut-berry']
  assign orange_variant = orange.variants.first
  assign berry_variant  = berry.variants.first
%}

<style>
/* ── Buy Box Section ── */
.fg-buybox-wrap {
  position: relative;
  padding: 0 0 80px;
  margin-top: -60px; /* overlap with hero */
  transition: background 400ms ease;
}
.fg-buybox-wrap[data-active-flavor="orange"] {
  background:
    radial-gradient(ellipse at 10% 60%, rgba(255,200,60,0.55) 0%, transparent 50%),
    radial-gradient(ellipse at 90% 30%, rgba(255,140,0,0.5) 0%, transparent 48%),
    radial-gradient(ellipse at 50% 100%, rgba(255,200,80,0.3) 0%, transparent 40%),
    #fff8f0;
}
.fg-buybox-wrap[data-active-flavor="berry"] {
  background:
    radial-gradient(ellipse at 10% 60%, rgba(220,30,150,0.45) 0%, transparent 50%),
    radial-gradient(ellipse at 90% 30%, rgba(160,0,140,0.5) 0%, transparent 48%),
    radial-gradient(ellipse at 50% 100%, rgba(200,20,160,0.3) 0%, transparent 40%),
    #fdf0f8;
}
.fg-buybox-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 var(--container-pad);
  display: grid;
  grid-template-columns: 1fr 520px;
  gap: 48px;
  align-items: center;
}

/* Left: product image */
.fg-buybox-img {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.fg-buybox-img img {
  width: 100%;
  max-width: 680px;
  height: auto;
  display: block;
  filter: drop-shadow(0 32px 64px rgba(24,6,26,.2));
  animation: fg-box-float 5s ease-in-out infinite;
}
@keyframes fg-box-float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-14px)} }

/* Right: buy card */
.fg-buybox-card {
  background: rgba(255,255,255,0.88);
  backdrop-filter: blur(16px);
  border-radius: 24px;
  padding: 32px;
  border: 1px solid rgba(255,255,255,0.95);
  box-shadow: 0 12px 56px rgba(24,6,26,.1), 0 2px 8px rgba(24,6,26,.06);
  position: relative;
  z-index: 2;
}
.fg-buybox-card__title { font-family:var(--font-display); font-size:clamp(24px,3vw,36px); font-weight:900; text-transform:uppercase; letter-spacing:var(--track-display); color:var(--fg-ink); margin:0 0 4px; line-height:1.05; }
.fg-buybox-card__sub { font-family:var(--font-body); font-size:13px; color:var(--fg-muted); margin:0 0 14px; }

/* Badges */
.fg-badges { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:18px; }
.fg-badge { font-family:var(--font-body); font-size:10px; font-weight:600; letter-spacing:.05em; text-transform:uppercase; color:var(--fg-ink); background:rgba(255,255,255,0.8); border:1px solid var(--fg-border); border-radius:var(--radius-pill); padding:4px 10px; }

/* Flavor pills */
.fg-flavors { display:flex; gap:8px; margin-bottom:18px; }
.fg-flavor-btn { flex:1; background:rgba(255,255,255,0.7); border:2px solid var(--fg-border); border-radius:var(--radius-md); padding:10px 12px; display:flex; align-items:center; gap:8px; font-family:var(--font-body); font-size:13px; font-weight:600; color:var(--fg-muted); cursor:pointer; transition:border-color 150ms, color 150ms, background 150ms; position:relative; }
.fg-flavor-btn.fg-flavor--active { border-color:var(--fg-orange); color:var(--fg-ink); background:#fff; }
.fg-flavor-dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; }
.fg-flavor-popular { position:absolute; top:-10px; right:10px; background:var(--fg-orange); color:#fff; font-size:9px; font-weight:800; letter-spacing:.06em; padding:2px 7px; border-radius:var(--radius-pill); text-transform:uppercase; }

/* Savings banner */
.fg-savings-banner { background:#e8f5e9; border-radius:var(--radius-md); padding:8px 14px; text-align:center; font-family:var(--font-body); font-size:12px; font-weight:700; color:#2e7d32; margin-bottom:12px; }

/* Tiers */
.fg-tier { background:rgba(255,255,255,0.9); border:2px solid var(--fg-border); border-radius:var(--radius-md); margin-bottom:8px; overflow:hidden; cursor:pointer; opacity:.72; transition:opacity 150ms, border-color 150ms; }
.fg-tier--selected { border-color:var(--fg-orange); opacity:1; }
.fg-tier__header { display:flex; align-items:flex-start; justify-content:space-between; padding:12px 14px; gap:10px; }
.fg-tier__radio { width:18px; height:18px; border-radius:50%; border:2px solid var(--fg-border); flex-shrink:0; margin-top:2px; transition:background 150ms,border-color 150ms; display:flex; align-items:center; justify-content:center; }
.fg-tier--selected .fg-tier__radio { background:var(--fg-orange); border-color:var(--fg-orange); }
.fg-tier__radio-dot { width:6px; height:6px; border-radius:50%; background:#fff; display:none; }
.fg-tier--selected .fg-tier__radio-dot { display:block; }
.fg-tier__meta { flex:1; }
.fg-tier__name { font-family:var(--font-body); font-size:13px; font-weight:700; color:var(--fg-ink); }
.fg-tier__save { color:var(--fg-orange); font-size:12px; }
.fg-tier__freq { font-size:11px; color:var(--fg-muted); margin-top:2px; }
.fg-tier__price { text-align:right; flex-shrink:0; }
.fg-tier__amount { font-family:var(--font-body); font-size:17px; font-weight:900; color:var(--fg-ink); }
.fg-tier__was { font-size:11px; color:#bbb; text-decoration:line-through; }
.fg-tier__perks { max-height:0; overflow:hidden; transition:max-height var(--motion-base) var(--ease-out); background:#fffbf7; border-top:1px solid #fde8d8; }
.fg-tier--selected .fg-tier__perks { max-height:200px; }
.fg-tier__perks-inner { padding:12px 14px; }
.fg-tier__perks-label { font-size:10px; font-weight:700; letter-spacing:.06em; color:var(--fg-muted); text-align:center; text-transform:uppercase; margin-bottom:10px; }
.fg-tier__perk { display:flex; align-items:center; gap:8px; font-family:var(--font-body); font-size:12px; color:var(--fg-ink); margin-bottom:6px; }
.fg-tier__perk-tag { font-size:9px; font-weight:800; padding:2px 6px; border-radius:4px; text-transform:uppercase; letter-spacing:.04em; flex-shrink:0; }
.fg-tier__perk-tag--free { background:var(--fg-orange); color:#fff; }
.fg-tier__perk-tag--exclusive { background:var(--fg-purple); color:#fff; }
.fg-tier__perk-tag--check { color:#22c55e; font-size:14px; }
.fg-tier__popular { background:var(--fg-orange); color:#fff; text-align:center; padding:5px; font-family:var(--font-body); font-size:9px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; }
.fg-onetime { text-align:center; margin-bottom:18px; }
.fg-onetime__link { font-family:var(--font-body); font-size:12px; color:var(--fg-muted); text-decoration:underline; cursor:pointer; background:none; border:none; padding:0; }
.fg-atc-btn { width:100%; background:var(--fg-orange); color:#fff; font-family:var(--font-body); font-size:15px; font-weight:900; letter-spacing:var(--track-btn); text-transform:uppercase; border:none; border-radius:var(--radius-pill); padding:17px; cursor:pointer; transition:background 150ms, transform 150ms; box-shadow:var(--shadow-cta); margin-bottom:12px; }
.fg-atc-btn:hover { background:var(--fg-orange-hot); transform:translateY(-1px); }
.fg-atc-btn:disabled { opacity:.6; cursor:not-allowed; transform:none; }
.fg-trust-strip { display:flex; border-top:1px solid var(--fg-border); padding-top:12px; }
.fg-trust-strip__item { flex:1; text-align:center; font-family:var(--font-body); font-size:9px; font-weight:700; color:var(--fg-muted); text-transform:uppercase; letter-spacing:.06em; border-right:1px solid var(--fg-border); padding:0 6px; }
.fg-trust-strip__item:last-child { border-right:none; }

@media(max-width:900px){
  .fg-buybox-wrap { margin-top:-20px; padding:0 0 56px; }
  .fg-buybox-inner { grid-template-columns:1fr; gap:0; }
  .fg-buybox-img { padding:32px 24px 0; display:flex; justify-content:center; }
  .fg-buybox-img img { max-width:min(360px, 90vw); }
  .fg-buybox-card { margin:0 16px; border-radius:16px; padding:24px 20px; }
  .fg-buybox-card__title { font-size:clamp(22px,6vw,32px); }
  .fg-flavors { gap:6px; }
  .fg-flavor-btn { padding:8px 10px; font-size:12px; }
}
</style>

<div class="fg-buybox-wrap" id="fg-buy-box" data-active-flavor="orange" data-flavor-section>
  <div class="fg-buybox-inner">

    <!-- Left: flavor-aware product image -->
    <div class="fg-buybox-img">
      <img data-flavor-image
           src="{{ 'fg-orange-box.png' | asset_url }}"
           alt="FlushGut Orange — High Fiber Jelly"
           width="540" loading="lazy">
    </div>

    <!-- Right: buy card -->
    <div class="fg-buybox-card">
      <div class="fg-buybox-card__title">{{ section.settings.title }}</div>
      <div class="fg-buybox-card__sub">{{ section.settings.subtitle }}</div>

      <div class="fg-badges">
        <span class="fg-badge">7G Dietary Fiber</span>
        <span class="fg-badge">Third-Party Tested</span>
        <span class="fg-badge">Once Weekly</span>
        <span class="fg-badge">HSA/FSA Eligible</span>
      </div>

      <div style="font-family:var(--font-body);font-size:10px;font-weight:700;letter-spacing:var(--track-label);text-transform:uppercase;color:var(--fg-muted);margin-bottom:8px;">Choose Your Flavor</div>
      <div class="fg-flavors">
        <button type="button"
                class="fg-flavor-btn fg-flavor--active"
                data-flavor-btn
                data-variant-id="{{ orange_variant.id }}"
                data-image-src="{{ 'fg-orange-box.png' | asset_url }}"
                data-image-alt="FlushGut Orange"
                data-section-bg="radial-gradient(ellipse at 10% 60%,rgba(255,200,60,0.55) 0%,transparent 50%),radial-gradient(ellipse at 90% 30%,rgba(255,140,0,0.5) 0%,transparent 48%),radial-gradient(ellipse at 50% 100%,rgba(255,200,80,0.3) 0%,transparent 40%),#fff8f0"
                data-flavor-key="orange"
                aria-pressed="true">
          <span class="fg-flavor-dot" style="background:#f37721;"></span>
          Orange
        </button>
        <button type="button"
                class="fg-flavor-btn"
                data-flavor-btn
                data-variant-id="{{ berry_variant.id }}"
                data-image-src="{{ 'fg-berry-box.png' | asset_url }}"
                data-image-alt="FlushGut Berry"
                data-section-bg="radial-gradient(ellipse at 10% 60%,rgba(220,30,150,0.45) 0%,transparent 50%),radial-gradient(ellipse at 90% 30%,rgba(160,0,140,0.5) 0%,transparent 48%),radial-gradient(ellipse at 50% 100%,rgba(200,20,160,0.3) 0%,transparent 40%),#fdf0f8"
                data-flavor-key="berry"
                aria-pressed="false"
                style="position:relative;">
          <span class="fg-flavor-dot" style="background:#a0237f;"></span>
          Berry
          <span class="fg-flavor-popular">Most Popular</span>
        </button>
      </div>

      <div class="fg-savings-banner">YOU SAVE $10/MO — $120/YR</div>

      <form data-atc-form>
        <input type="hidden" data-variant-input value="{{ orange_variant.id }}">
        <input type="hidden" data-selling-plan-input name="selling_plan" value="{{ plan_11wk }}">

        <div class="fg-tier fg-tier--selected"
             data-tier
             data-selling-plan="{{ plan_11wk }}"
             data-price="$27.99/mo"
             aria-expanded="true">
          <div class="fg-tier__header">
            <div class="fg-tier__radio"><div class="fg-tier__radio-dot"></div></div>
            <div class="fg-tier__meta">
              <div class="fg-tier__name">3 Months of FlushGut <span class="fg-tier__save">(SAVE 30%)</span></div>
              <div class="fg-tier__freq">Ships every 11 weeks · 1-week buffer so you never run out</div>
            </div>
            <div class="fg-tier__price">
              <div class="fg-tier__amount">$27.99</div>
              <div class="fg-tier__was">$39.99/box</div>
              <div style="font-size:10px;color:var(--fg-muted);">per box</div>
            </div>
          </div>
          <div class="fg-tier__perks" data-tier-perks>
            <div class="fg-tier__perks-inner">
              <div class="fg-tier__perks-label">Everything in 6-Week, Plus</div>
              <div class="fg-tier__perk"><span class="fg-tier__perk-tag fg-tier__perk-tag--free">Free</span> Welcome Kit <span style="color:var(--fg-muted);">($42 value)</span></div>
              <div class="fg-tier__perk"><span class="fg-tier__perk-tag fg-tier__perk-tag--free">Free</span> Mystery Gift <span style="color:var(--fg-muted);">($18 value)</span></div>
              <div class="fg-tier__perk"><span class="fg-tier__perk-tag--check">&#10003;</span> 60-day money-back guarantee</div>
              <div class="fg-tier__perk"><span class="fg-tier__perk-tag fg-tier__perk-tag--exclusive">Exclusive</span> Access to the FlushGut Method library</div>
            </div>
          </div>
          <div class="fg-tier__popular">Most Popular</div>
        </div>

        <div class="fg-tier"
             data-tier
             data-selling-plan="{{ plan_5wk }}"
             data-price="$29.99/mo"
             aria-expanded="false">
          <div class="fg-tier__header">
            <div class="fg-tier__radio"><div class="fg-tier__radio-dot"></div></div>
            <div class="fg-tier__meta">
              <div class="fg-tier__name">6 Weeks of FlushGut <span class="fg-tier__save">(SAVE 25%)</span></div>
              <div class="fg-tier__freq">Ships every 5 weeks · 1-week buffer so you never run out</div>
            </div>
            <div class="fg-tier__price">
              <div class="fg-tier__amount">$29.99</div>
              <div class="fg-tier__was">$39.99/box</div>
            </div>
          </div>
          <div class="fg-tier__perks" data-tier-perks>
            <div class="fg-tier__perks-inner">
              <div class="fg-tier__perk"><span class="fg-tier__perk-tag fg-tier__perk-tag--free">Free</span> Welcome Kit <span style="color:var(--fg-muted);">($42 value)</span></div>
              <div class="fg-tier__perk"><span class="fg-tier__perk-tag--check">&#10003;</span> 60-day money-back guarantee</div>
              <div class="fg-tier__perk"><span class="fg-tier__perk-tag--check">&#10003;</span> Cancel or pause anytime</div>
            </div>
          </div>
        </div>

        <div class="fg-onetime">
          <button type="button" class="fg-onetime__link"
                  data-tier
                  data-selling-plan=""
                  data-price="$39.99"
                  aria-expanded="false">
            One Time Purchase for $39.99
          </button>
        </div>

        <button type="submit" class="fg-atc-btn" data-atc-btn
                data-default-label="Start My FlushGut Routine &#8212; $27.99/mo">
          <span data-cta-label>Start My FlushGut Routine &#8212; $27.99/mo</span>
        </button>
      </form>

      <div class="fg-trust-strip">
        <div class="fg-trust-strip__item">Free US Shipping</div>
        <div class="fg-trust-strip__item">60-Day Guarantee</div>
        <div class="fg-trust-strip__item">Cancel Anytime</div>
      </div>
    </div>

  </div>
</div>

<script src="{{ 'fg-buy-box.js' | asset_url }}" defer></script>
<script>
(function(){
  var wrap = document.querySelector('[data-flavor-section]');
  if (!wrap) return;
  document.querySelectorAll('[data-flavor-btn]').forEach(function(btn){
    btn.addEventListener('click', function(){
      if (btn.dataset.sectionBg) {
        wrap.style.background = btn.dataset.sectionBg;
      }
      if (btn.dataset.flavorKey) {
        wrap.setAttribute('data-active-flavor', btn.dataset.flavorKey);
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "FlushGut Buy Box",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Product title", "default": "FlushGut Essentials" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "All-in-One Weekly Gut Support" },
    { "type": "text", "id": "selling_plan_5wk", "label": "Selling plan ID — 6-week", "info": "Numeric ID only.", "default": "6089310437" },
    { "type": "text", "id": "selling_plan_11wk", "label": "Selling plan ID — 3-month", "info": "Create in Appstle first." }
  ],
  "presets": [{ "name": "FlushGut Buy Box" }]
}
{% endschema %}
