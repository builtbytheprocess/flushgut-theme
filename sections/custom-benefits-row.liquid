{%- comment -%}
  "It's not in your head" — five benefit cards on espresso.

  Comp: y1730-2230 (500px). Centred eyebrow 23.1px @ y1773 · two headline lines
  38.9px, the first in caramel · five outlined cards ~190px wide with a 21px
  title @ y2026 and 14px body copy.
{%- endcomment -%}

<section class="fg-benefits">
  <div class="fg-benefits__inner">

    <p class="fg-benefits__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="fg-benefits__title">
      <span class="fg-benefits__title-a">{{ section.settings.title_a }}</span>
      <span class="fg-benefits__title-b">{{ section.settings.title_b }}</span>
    </h2>

    <ul class="fg-benefits__grid">
      {%- for block in section.blocks -%}
        <li class="fg-benefit" {{ block.shopify_attributes }}>
          {%- render 'fg-icon', name: block.settings.icon -%}
          <h3 class="fg-benefit__title">{{ block.settings.title }}</h3>
          <p class="fg-benefit__copy">{{ block.settings.copy }}</p>
        </li>
      {%- endfor -%}
    </ul>

  </div>
</section>

<style>
  .fg-benefits { background: var(--fg-espresso); color: var(--fg-on-dark); }
  .fg-benefits__inner {
    max-width: 1000px;
    margin-inline: auto;
    padding: 44px var(--container-pad) 48px;
    text-align: center;
  }

  .fg-benefits__eyebrow {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: clamp(15px, 1.25vw, 23px);
    font-weight: var(--fg-w-bold);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--fg-on-dark);
  }
  .fg-benefits__title {
    margin: 0 0 42px;
    font-family: var(--font-display);
    font-size: clamp(24px, 2.7vw, 39px);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: var(--track-display);
    text-transform: uppercase;
  }
  .fg-benefits__title-a,
  .fg-benefits__title-b { display: block; }
  .fg-benefits__title-a { color: var(--fg-caramel-light); }
  .fg-benefits__title-b { color: var(--fg-on-dark); }

  .fg-benefits__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fg-benefit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 22px 14px 20px;
    border: 1px solid var(--fg-rule-dark);
    border-radius: var(--radius-md);
    text-align: center;
  }
  .fg-benefit .fg-i { width: 46px; height: 46px; color: var(--fg-on-dark); }
  .fg-benefit__title {
    margin: 0;
    /* Two lines are reserved so "Brain & Mood" wrapping does not push that
       card's body copy out of line with the other four. */
    min-height: 2.1em;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display);
    font-size: clamp(14px, 1.15vw, 20px);
    font-weight: var(--fg-w-display);
    letter-spacing: var(--track-display);
    text-transform: uppercase;
    color: var(--fg-caramel-light);
  }
  .fg-benefit__copy {
    margin: 0;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.42;
    color: var(--fg-on-dark-dim);
  }

  @media (max-width: 900px) {
    .fg-benefits__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 600px) {
    .fg-benefits__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .fg-benefit { padding: 18px 12px; }
  }
</style>

{% schema %}
{
  "name": "FlushGut Benefits",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Real Reason You Feel This Way" },
    { "type": "text", "id": "title_a", "label": "Headline line 1", "default": "It's Not In Your Head" },
    { "type": "text", "id": "title_b", "label": "Headline line 2", "default": "It's What No One Warned You About." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon name", "default": "gut-health" },
        { "type": "text", "id": "title", "label": "Title", "default": "Gut Health" },
        { "type": "textarea", "id": "copy", "label": "Copy" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FlushGut Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "gut-health", "title": "Gut Health", "copy": "Prebiotic fiber and probiotic strains work together to support a balanced microbiome and regular, comfortable digestion." } },
        { "type": "benefit", "settings": { "icon": "immunity", "title": "Immunity", "copy": "70% of your immune system lives in your gut. A healthy, balanced microbiome may help support your body's natural defenses.*" } },
        { "type": "benefit", "settings": { "icon": "energy", "title": "Energy", "copy": "When your gut absorbs nutrients efficiently, your energy may follow. Less sluggishness, more vitality throughout the day.*" } },
        { "type": "benefit", "settings": { "icon": "brain-mood", "title": "Brain & Mood", "copy": "The gut-brain axis is real. A balanced microbiome may support clearer thinking, focus, and a calmer mood.*" } },
        { "type": "benefit", "settings": { "icon": "skin", "title": "Skin", "copy": "Gut imbalances often show up on your skin. Supporting your gut microbiome may help reduce internal inflammation that affects skin health.*" } }
      ]
    }
  ]
}
{% endschema %}
