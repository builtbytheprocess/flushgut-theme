{%- comment -%}
  FlushGut Essentials — buy box + sustainability panel.

  Rebuilt 2026-09-03 from the design comp. The comp draws these as one row:
  a tan buy-box panel on the left (0-1097px of 1920) and a photographic
  sustainability panel on the right, so they live in one section rather than
  two that would stack.

  PRICING IS READ LIVE FROM SHOPIFY. Each format block takes a product picker;
  the card renders that product's real price, its subscription allocation and
  the resulting discount. A block with no product assigned falls back to the
  comp's figures and renders inert ("Coming Soon") — which is how Capsule and
  Gummy ship until those products exist in the catalogue. Nothing here
  hardcodes a sellable price.

  Comp geometry (CSS px @1920): heading y725/24px · chips y765/14.5px ·
  cards x470/676/882, header y823/19px · price y934/36px · CTA y1041.
{%- endcomment -%}

{%- liquid
  assign has_purchasable = false
  for block in section.blocks
    if block.settings.product != blank
      assign has_purchasable = true
    endif
  endfor
-%}

<section class="fg-essentials" id="fg-buy-box">

  {%- comment -%} ── Left: buy box ── {%- endcomment -%}
  <div class="fg-essentials__buy">
    <div class="fg-essentials__inner">

      <h2 class="fg-essentials__title">
        {%- render 'fg-logo' -%}
        <span class="fg-essentials__title-word">{{ section.settings.title }}</span>
      </h2>

      <ul class="fg-chips">
        {%- assign chips = section.settings.chips | split: ',' -%}
        {%- for chip in chips -%}
          <li class="fg-chip">{{ chip | strip }}</li>
        {%- endfor -%}
      </ul>

      <div class="fg-formats" role="radiogroup" aria-label="Choose your format">
        {%- for block in section.blocks -%}
          {%- liquid
            comment
              A format either sells one product, or offers flavours that are
              separate products (Orange and Berry are distinct products in this
              catalogue, not variants of one). Selecting a flavour changes the
              package image and the product added to the cart. Nothing else on
              the page reacts to it, by design.
            endcomment
            assign flavours = ''
            if block.settings.flavor_a_product != blank
              assign flavours = 'a'
              if block.settings.flavor_b_product != blank
                assign flavours = 'a,b'
              endif
            endif
            assign flavour_list = flavours | split: ','

            assign prod = block.settings.product
            if flavour_list.size > 0
              assign prod = block.settings.flavor_a_product
            endif

            assign live = false
            assign variant_id = ''
            assign plan_id = ''
            assign sub_price = block.settings.fallback_sub_price
            assign one_price = block.settings.fallback_one_price
            assign save_pct  = block.settings.fallback_save_pct | plus: 0

            if prod != blank and prod.available
              assign v = prod.selected_or_first_available_variant
              if v != blank
                assign live = true
                assign variant_id = v.id
                assign one_price = v.price | money_without_trailing_zeros
                assign alloc = v.selling_plan_allocations | first
                if alloc != blank
                  assign plan_id = alloc.selling_plan.id
                  assign sub_price = alloc.price | money_without_trailing_zeros
                  assign diff = v.price | minus: alloc.price
                  assign save_pct = diff | times: 100.0 | divided_by: v.price | round
                else
                  assign sub_price = one_price
                  assign save_pct = 0
                endif
              endif
            endif
          -%}
          <div class="fg-format{% if forloop.first %} is-selected{% endif %}{% unless live %} is-unavailable{% endunless %}"
               data-format
               data-live="{{ live }}"
               data-variant-id="{{ variant_id }}"
               data-selling-plan="{{ plan_id }}"
               data-sub-price="{{ sub_price }}"
               data-one-price="{{ one_price }}">
            <button type="button" class="fg-format__head"
                    role="radio"
                    aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
                    {% unless live %}aria-disabled="true"{% endunless %}>
              <span class="fg-format__radio" aria-hidden="true">
                {%- render 'fg-icon', name: 'radio-on' -%}
                {%- render 'fg-icon', name: 'radio-off' -%}
              </span>
              <span class="fg-format__name">{{ block.settings.name }}</span>
            </button>

            <div class="fg-format__body">
              {%- unless flavour_list.size > 0 -%}
                {%- liquid
                  assign shot = block.settings.card_image
                  unless shot
                    assign shot = block.settings.product.featured_image
                  endunless
                -%}
                <div class="fg-format__shot">
                  {%- if shot -%}
                    <img src="{{ shot | image_url: width: 400 }}"
                         alt="{{ block.settings.name | escape }}" width="160" height="160" loading="lazy">
                  {%- elsif block.settings.fallback_image != blank -%}
                    <img src="{{ block.settings.fallback_image | asset_url }}"
                         alt="{{ block.settings.name | escape }}" width="160" height="160" loading="lazy">
                  {%- endif -%}
                </div>
              {%- endunless -%}

              {%- if flavour_list.size > 0 -%}
                {%- liquid
                  comment
                    Flavour art, in the same order the closing grid uses: an
                    explicit per-flavour image, then the card's brand render,
                    then the product's own photograph.

                    Today only the brand render exists, so both flavours show
                    the same pack and the swap is invisible. That is deliberate:
                    the previous magenta carton is kept off the homepage, and it
                    still ships, so the product page gallery is where a customer
                    sees what actually arrives. Drop per-flavour renders into
                    flavor_a_image / flavor_b_image and the swap becomes visible
                    with no code change.
                  endcomment
                  assign fa_src = ''
                  if block.settings.flavor_a_image != blank
                    assign fa_src = block.settings.flavor_a_image | image_url: width: 400
                  elsif block.settings.fallback_image != blank
                    assign fa_src = block.settings.fallback_image | asset_url
                  elsif block.settings.flavor_a_product.featured_image != blank
                    assign fa_src = block.settings.flavor_a_product.featured_image | image_url: width: 400
                  endif

                  assign fb_src = ''
                  if block.settings.flavor_b_image != blank
                    assign fb_src = block.settings.flavor_b_image | image_url: width: 400
                  elsif block.settings.fallback_image != blank
                    assign fb_src = block.settings.fallback_image | asset_url
                  elsif block.settings.flavor_b_product.featured_image != blank
                    assign fb_src = block.settings.flavor_b_product.featured_image | image_url: width: 400
                  endif
                -%}
                <div class="fg-format__shot">
                  <img data-flavor-image
                       src="{{ fa_src }}"
                       alt="{{ block.settings.flavor_a_label | escape }}"
                       width="160" height="160" loading="lazy">
                </div>

                <div class="fg-format__flavors" role="radiogroup" aria-label="Choose your flavor">
                  {%- for key in flavour_list -%}
                    {%- liquid
                      if key == 'a'
                        assign fp = block.settings.flavor_a_product
                        assign flabel = block.settings.flavor_a_label
                        assign fimg_src = fa_src
                      else
                        assign fp = block.settings.flavor_b_product
                        assign flabel = block.settings.flavor_b_label
                        assign fimg_src = fb_src
                      endif
                      assign fv = fp.selected_or_first_available_variant
                      assign f_one = fv.price | money_without_trailing_zeros
                      assign f_alloc = fv.selling_plan_allocations | first
                      assign f_plan = ''
                      assign f_sub = f_one
                      assign f_save = 0
                      if f_alloc != blank
                        assign f_plan = f_alloc.selling_plan.id
                        assign f_sub = f_alloc.price | money_without_trailing_zeros
                        assign f_diff = fv.price | minus: f_alloc.price
                        assign f_save = f_diff | times: 100.0 | divided_by: fv.price | round
                      endif
                    -%}
                    <button type="button" class="fg-flavor{% if forloop.first %} is-selected{% endif %}"
                            data-flavor
                            role="radio"
                            aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
                            data-variant-id="{{ fv.id }}"
                            data-selling-plan="{{ f_plan }}"
                            data-sub-price="{{ f_sub }}"
                            data-one-price="{{ f_one }}"
                            data-save="{{ f_save }}"
                            data-image="{{ fimg_src }}">{{ flabel }}</button>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <p class="fg-format__sub">
                <span>{{ section.settings.sub_label }}</span>
                <strong class="fg-format__save" data-save-label{% if save_pct == 0 %} hidden{% endif %}>(Save {{ save_pct }}%)</strong>
              </p>
              <p class="fg-format__terms">{{ section.settings.terms }}</p>
              <p class="fg-format__price">
                <span class="fg-format__price-main" data-price-main>{{ sub_price }}</span>
                <span class="fg-format__price-unit">{{ block.settings.pack }}</span>
              </p>
              <p class="fg-format__compare"><s data-price-compare>{{ one_price }} / box</s></p>
              {%- comment -%}
                Always rendered, hidden when the format is purchasable: the line
                reserves its own height so every card's price sits on the same
                baseline, which is how the comp aligns the row.
              {%- endcomment -%}
              <p class="fg-format__soon"{% if live %} aria-hidden="true" data-placeholder{% endif %}>{{ section.settings.soon_label }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <form data-atc-form class="fg-essentials__form">
        <input type="hidden" data-variant-input name="id" value="">
        <input type="hidden" data-selling-plan-input name="selling_plan" value="">
        <button type="submit" class="fg-btn fg-essentials__cta" data-atc-btn
                data-default-label="{{ section.settings.cta_label | escape }}"
                {% unless has_purchasable %}disabled{% endunless %}>
          <span data-cta-label>{{ section.settings.cta_label }}</span>
          {%- render 'fg-icon', name: 'play' -%}
        </button>
      </form>

      <button type="button" class="fg-essentials__onetime" data-onetime>
        {{ section.settings.onetime_label }}
      </button>

      <ul class="fg-essentials__trust">
        {%- assign trust = section.settings.trust | split: ',' -%}
        {%- for item in trust -%}
          {%- assign bits = item | split: '|' -%}
          <li>
            {%- render 'fg-icon', name: bits[0] -%}
            <span>{{ bits[1] | strip | newline_to_br }}</span>
          </li>
        {%- endfor -%}
      </ul>

    </div>
  </div>

  {%- comment -%} ── Right: sustainability ── {%- endcomment -%}
  <div class="fg-essentials__sustain">
    <div class="fg-sustain__inner">
      <p class="fg-sustain__eyebrow">{{ section.settings.sustain_eyebrow }}</p>
      <h3 class="fg-sustain__title">{{ section.settings.sustain_title | newline_to_br }}</h3>
      <ul class="fg-sustain__list">
        {%- assign points = section.settings.sustain_points | split: ',' -%}
        {%- for point in points -%}
          {%- assign bits = point | split: '|' -%}
          <li>
            {%- render 'fg-icon', name: bits[0] -%}
            <span>{{ bits[1] | strip | newline_to_br }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

</section>

<style>
  .fg-essentials {
    display: grid;
    grid-template-columns: minmax(0, 1097fr) minmax(0, 823fr);
    background: var(--fg-kraft);
  }

  /* ── Left panel ── */
  .fg-essentials__buy { display: flex; justify-content: flex-end; }
  .fg-essentials__inner {
    width: 100%;
    max-width: 651px;
    padding: 34px clamp(24px, 4.5vw, 87px) 30px 24px;
  }

  .fg-essentials__title {
    display: flex; align-items: baseline; gap: 12px;
    margin: 0 0 12px;
  }
  .fg-essentials__title .fg-logo__svg { width: 176px; height: auto; }
  .fg-essentials__title-word {
    font-family: var(--font-display);
    font-size: 24px; font-weight: var(--fg-w-display);
    letter-spacing: 0.01em; text-transform: uppercase;
    color: var(--fg-espresso);
  }

  .fg-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 16px; padding: 0; list-style: none; }
  .fg-chip {
    font-family: var(--font-body); font-size: 10px; font-weight: var(--fg-w-bold);
    letter-spacing: 0.04em; text-transform: uppercase; color: var(--fg-espresso);
    border: 1px solid var(--fg-rule-light); border-radius: var(--radius-sm);
    padding: 5px 8px; white-space: nowrap;
  }

  /* ── Format cards ── */
  .fg-formats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 11px; margin-bottom: 18px; }
  .fg-format {
    display: flex;
    flex-direction: column;
    background: var(--fg-parchment);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: border-color var(--motion-fast) var(--ease-out);
  }
  .fg-format.is-selected { border-color: var(--fg-espresso); }
  .fg-format.is-unavailable { opacity: 0.72; }

  .fg-format__head {
    width: 100%; display: flex; align-items: center; gap: 8px;
    padding: 10px 12px; background: var(--fg-caramel); border: 0;
    cursor: pointer; text-align: left; color: var(--fg-on-dark);
  }
  .fg-format.is-unavailable .fg-format__head { cursor: not-allowed; }
  .fg-format__radio { display: block; width: 16px; height: 16px; flex: 0 0 auto; }
  .fg-format__radio .fg-i { width: 16px; height: 16px; }
  .fg-format__radio .fg-i:first-child { display: none; }
  .fg-format.is-selected .fg-format__radio .fg-i:first-child { display: block; }
  .fg-format.is-selected .fg-format__radio .fg-i:last-child { display: none; }
  .fg-format__name {
    font-family: var(--font-display); font-size: 19px; font-weight: var(--fg-w-display);
    letter-spacing: 0.01em; text-transform: uppercase;
  }

  /* Column layout with the price pushed to the bottom: the Jelly card carries a
     flavour row the others do not, and without this its price would sit lower
     than Gummy's and Capsule's, which the comp aligns. */
  .fg-format__body { display: flex; flex-direction: column; flex: 1; padding: 12px 12px 14px; }

  /* Flavour packshot. The current Orange and Berry photographs are opaque with
     a near-white ground, so the image sits in a white product tile — that reads
     as deliberate now, and still works when transparent brown renders replace
     them. The tile has a fixed square aspect so swapping flavours can never
     reflow the card. */
  .fg-format__shot {
    background: #fff;
    border-radius: var(--radius-sm);
    height: 92px;
    margin-bottom: 10px;
    overflow: hidden;
  }
  .fg-format__shot img { width: 100%; height: 100%; object-fit: contain; display: block; }

  .fg-format__flavors { display: flex; gap: 6px; margin-bottom: 11px; }
  .fg-flavor {
    flex: 1 1 0;
    padding: 6px 4px;
    background: transparent;
    border: 1px solid var(--fg-rule-light);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 11px; font-weight: var(--fg-w-bold);
    letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--fg-espresso);
  }
  .fg-flavor.is-selected { background: var(--fg-espresso); border-color: var(--fg-espresso); color: var(--fg-on-dark); }
  .fg-format__save[hidden] { display: none; }
  .fg-format__soon[data-placeholder] { visibility: hidden; }
  .fg-format__sub,
  .fg-format__terms,
  .fg-format__price,
  .fg-format__compare,
  .fg-format__soon { margin: 0; font-family: var(--font-body); color: var(--fg-espresso); }
  .fg-format__sub { font-size: 14px; line-height: 1.25; white-space: nowrap; }
  .fg-format__save { display: block; font-weight: 700; }
  .fg-format__terms { margin-top: 6px; font-size: 11px; color: var(--fg-on-light-dim); line-height: 1.3; }
  /* margin-top:auto must live here: the shared `margin: 0` rule above this
     point would otherwise reset it, which is what misaligned the prices. */
  .fg-format__price { margin-top: auto; padding-top: 12px; display: flex; align-items: baseline; gap: 5px; }
  .fg-format__price-main { font-family: var(--font-display); font-size: 30px; font-weight: 800; letter-spacing: -0.02em; }
  .fg-format__price-unit { font-size: 12px; color: var(--fg-on-light-dim); white-space: nowrap; }
  .fg-format__compare { font-size: 14px; color: var(--fg-on-light-dim); }
  .fg-format__soon {
    margin-top: 10px; font-size: 10px; font-weight: 700;
    letter-spacing: var(--track-label); text-transform: uppercase; color: var(--fg-espresso);
  }

  /* ── Actions ── */
  .fg-essentials__form { margin: 0 0 10px; }
  .fg-essentials__cta { font-size: 14px; padding: 14px 26px; }
  .fg-essentials__onetime {
    display: block; margin: 0 0 18px; padding: 0;
    background: none; border: 0; cursor: pointer;
    font-family: var(--font-body); font-size: 14px;
    color: var(--fg-espresso); text-decoration: underline;
    text-underline-offset: 3px;
  }
  .fg-essentials__onetime[aria-pressed="true"] { font-weight: 700; }

  .fg-essentials__trust { display: flex; gap: 26px; margin: 0; padding: 0; list-style: none; }
  .fg-essentials__trust li {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    text-align: center;
    font-family: var(--font-body); font-size: 11px; font-weight: var(--fg-w-bold);
    letter-spacing: 0.04em; line-height: 1.2; text-transform: uppercase;
    color: var(--fg-espresso);
  }
  .fg-essentials__trust .fg-i { width: 26px; height: 26px; }

  /* ── Right panel ── */
  .fg-essentials__sustain {
    position: relative;
    background-color: var(--fg-kraft);
    background-image: url('{{ 'fg-sustainability-hands.jpg' | asset_url }}');
    background-size: cover;
    background-position: left center;
    display: flex;
    align-items: center;
  }
  .fg-sustain__inner { padding: 40px clamp(24px, 3vw, 48px); max-width: 520px; }
  .fg-sustain__eyebrow {
    margin: 0 0 6px;
    font-family: var(--font-body); font-size: 15px; font-weight: 700;
    letter-spacing: 0.02em; text-transform: uppercase; color: var(--fg-espresso);
  }
  .fg-sustain__title {
    margin: 0 0 30px;
    font-family: var(--font-display); font-size: clamp(24px, 2.3vw, 33px);
    font-weight: var(--fg-w-display); line-height: 1.1; letter-spacing: var(--track-display);
    color: var(--fg-espresso);
  }
  .fg-sustain__list { margin: 0; padding: 0; list-style: none; display: grid; gap: 22px; }
  .fg-sustain__list li {
    display: flex; align-items: center; gap: 13px;
    font-family: var(--font-body); font-size: 14px; font-weight: 700;
    letter-spacing: 0.03em; line-height: 1.2; text-transform: uppercase;
    color: var(--fg-espresso);
  }
  .fg-sustain__list .fg-i { width: 34px; height: 34px; flex: 0 0 auto; }

  /* ── Responsive ── */
  /* Stacked, the panel is far taller than it is wide, so `cover` crops to the
     hands and the heading loses its light ground. A scrim keeps the copy
     legible without changing the desktop composition. */
  @media (max-width: 1100px) {
    .fg-essentials__sustain::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(180deg,
        rgba(222, 198, 166, 0.94) 0%,
        rgba(222, 198, 166, 0.80) 42%,
        rgba(222, 198, 166, 0.12) 100%);
    }
    .fg-sustain__inner { position: relative; z-index: 1; }
    .fg-essentials { grid-template-columns: 1fr; }
    .fg-essentials__buy { justify-content: center; }
    .fg-essentials__inner { max-width: 640px; padding-inline: var(--container-pad); }
    .fg-essentials__sustain { min-height: 340px; }
    .fg-sustain__inner { margin-inline: auto; }
  }
  @media (max-width: 620px) {
    /* "FlushGut ESSENTIALS" was breaking mid-word at 390px. */
    .fg-essentials__title { flex-wrap: wrap; gap: 8px; }
    .fg-essentials__title .fg-logo__svg { width: 140px; }
    .fg-essentials__title-word { font-size: 20px; white-space: nowrap; }
    .fg-formats { grid-template-columns: 1fr; }
    .fg-essentials__cta { width: 100%; justify-content: center; }
    .fg-essentials__trust { gap: 14px; }
    .fg-chip { font-size: 11px; padding: 7px 10px; }
    .fg-essentials__trust li { font-size: 10.5px; }
    .fg-essentials__trust .fg-i { width: 30px; height: 30px; }
  }
  /* Touch targets: the one-time link is a 15px-tall text run on desktop. */
  @media (pointer: coarse) {
    .fg-essentials__onetime { padding-block: 14px; }
    .fg-flavor { padding-block: 11px; }
  }
</style>

{%- comment -%}
  Cart-drawer refresh patch — carried over from the previous buy box. Shopify's
  drawer only re-renders when /cart/add is given a `sections` payload; this
  wraps fetch to add it. Kept verbatim because it is known-good.
{%- endcomment -%}
<script>(function(){if(window.__fgCartRefreshPatched)return;window.__fgCartRefreshPatched=true;var o=window.fetch;window.fetch=function(i,n){try{var u=typeof i==='string'?i:(i&&i.url)||'';if(u.indexOf('/cart/add')!==-1&&n&&typeof n.body==='string'){var d=JSON.parse(n.body);var cd=document.querySelector('cart-drawer');if(cd&&!d.sections){d.sections=cd.getSectionsToRender?cd.getSectionsToRender().map(function(s){return s.id;}):['cart-drawer','cart-icon-bubble'];d.sections_url=window.location.pathname;var nn=Object.assign({},n,{body:JSON.stringify(d)});return o.call(this,i,nn).then(function(r){try{r.clone().json().then(function(j){if(j&&j.sections&&cd&&typeof cd.renderContents==='function'){cd.classList.remove('is-empty');cd.renderContents(j);}}).catch(function(){});}catch(e){}return r;});}}}catch(e){}return o.apply(this,arguments);};})();</script>
<script src="{{ 'fg-format-picker.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "FlushGut Essentials",
  "tag": "div",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "title", "label": "Heading word after logo", "default": "Essentials" },
    { "type": "text", "id": "chips", "label": "Chips (comma separated)",
      "default": "Clinically Studied,Third-Party Tested,3x Per Week,HSA/FSA Eligible" },
    { "type": "text", "id": "sub_label", "label": "Subscription label", "default": "Subscribe & Save" },
    { "type": "text", "id": "terms", "label": "Subscription terms", "default": "Ships monthly, pause or cancel anytime." },
    { "type": "text", "id": "soon_label", "label": "Label for formats with no product", "default": "Coming Soon" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Start My FlushGut Routine" },
    { "type": "text", "id": "onetime_label", "label": "One-time purchase link", "default": "Start with a one time purchase" },
    { "type": "textarea", "id": "trust", "label": "Trust items", "info": "icon-name|Label",
      "default": "truck|Free US\nShipping,clinicians|Clinician\nReviewed,cancel-anytime|Cancel\nAnytime" },
    { "type": "header", "content": "Sustainability panel" },
    { "type": "text", "id": "sustain_eyebrow", "label": "Eyebrow", "default": "Sustainability is in our DNA" },
