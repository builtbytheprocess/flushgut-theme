.fg-btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; font-family:var(--font-display); font-weight:800; font-size:17px; letter-spacing:var(--track-btn); text-transform:uppercase; text-decoration:none; border-radius:var(--radius-md); padding:16px 40px; border:2px solid transparent; cursor:pointer; white-space:nowrap; transition:transform var(--motion-fast) var(--ease-out),box-shadow var(--motion-fast) var(--ease-out),background-color var(--motion-fast) var(--ease-out),color var(--motion-fast) var(--ease-out),border-color var(--motion-fast) var(--ease-out); }
.fg-btn-outline { background:transparent; color:var(--fg-orange); border-color:var(--fg-orange); }
.fg-btn-outline:hover { background:var(--fg-orange); color:#fff; transform:translateY(-2px); }
.fg-glp1-bridge { border-left:4px solid var(--fg-orange); padding-left:32px; }
.fg-bridge-links { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:72px; }
.fg-bridge-link { text-decoration:none; padding:24px; border:1px solid var(--fg-border); border-radius:var(--radius-lg); display:block; transition:border-color var(--motion-fast),box-shadow var(--motion-fast); }
.fg-bridge-link:hover { border-color:var(--fg-orange); box-shadow:0 4px 20px rgba(243,119,33,0.1); }
.fg-bridge-link__label { font-family:var(--font-body); font-size:12px; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--fg-orange); margin-bottom:10px; }
.fg-bridge-link__title { font-family:var(--font-display); font-size:22px; font-weight:700; text-transform:uppercase; color:var(--fg-ink); line-height:1.1; margin-bottom:8px; }
.fg-bridge-link__desc  { font-size:14px; color:var(--fg-muted); }
@media (max-width:900px) { .fg-bridge-links { grid-template-columns:1fr !important; } }
