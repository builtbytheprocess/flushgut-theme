<style>
/* ── Hero Image — self-contained ── */
.fg-hero-link { display:block; width:100%; line-height:0; cursor:pointer; overflow:hidden; }
.fg-hero-link picture { display:block; width:100%; }
.fg-hero-link img { width:100%; height:auto; display:block; max-width:100%; }
</style>

<a class="fg-hero-link" href="#fg-buy-box" id="fg-hero" aria-label="Shop FlushGut — Start My Routine">
  <picture>
    <source media="(max-width: 767px)" srcset="{{ 'fg-hero-mobile.png' | asset_url }}">
    <img src="{{ 'fg-hero-desktop.png' | asset_url }}"
         alt="FlushGut — One Jelly Stick. Three Times a Week."
         loading="eager" fetchpriority="high">
  </picture>
</a>

{% schema %}
{
  "name": "FlushGut Hero",
  "tag": "div",
  "settings": [
    { "type": "url", "id": "cta_url", "label": "Click destination", "info": "Where the image links. Default: #fg-buy-box" }
  ],
  "presets": [{ "name": "FlushGut Hero" }]
}
{% endschema %}
