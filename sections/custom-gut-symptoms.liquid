{%- comment -%}
  "Does this sound like you?" — symptoms band on kraft paper.

  Comp: y1128-1730 (602px). Eyebrow 28.9px @ x461/y1187 · headline 42.2px on two
  lines, second line in caramel · speech bubble 18px @ x1089 · five icons with
  21px two-line labels @ y1472 · stat line and CTA @ y1577-1605.
{%- endcomment -%}

<section class="fg-symptoms">
  <div class="fg-symptoms__inner">

    <div class="fg-symptoms__head">
      <div>
        <p class="fg-symptoms__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="fg-symptoms__title">
          <span class="fg-symptoms__title-a">{{ section.settings.title_a }}</span>
          <span class="fg-symptoms__title-b">{{ section.settings.title_b }}</span>
        </h2>
      </div>
      {%- if section.settings.bubble != blank -%}
        <p class="fg-symptoms__bubble">{{ section.settings.bubble }}</p>
      {%- endif -%}
    </div>

    <ul class="fg-symptoms__list">
      {%- assign items = section.settings.items | split: ',' -%}
      {%- for item in items -%}
        {%- assign bits = item | split: '|' -%}
        <li>
          {%- render 'fg-icon', name: bits[0] -%}
          <span>{{ bits[1] | strip | newline_to_br }}</span>
        </li>
      {%- endfor -%}
    </ul>

    <div class="fg-symptoms__foot">
      <div class="fg-symptoms__stat">
        <p class="fg-symptoms__stat-lead">
          {{ section.settings.stat_lead }}<sup><a href="{{ section.settings.source_url }}" rel="nofollow noopener" target="_blank">1</a></sup>
        </p>
        <p class="fg-symptoms__stat-strong">{{ section.settings.stat_strong }}</p>
        <p class="fg-symptoms__source">
          <sup>1</sup> <a href="{{ section.settings.source_url }}" rel="nofollow noopener" target="_blank">{{ section.settings.source_url }}</a>
        </p>
      </div>
      <a class="fg-btn fg-symptoms__cta" href="{{ section.settings.cta_url | default: '#fg-buy-box' }}">
        {{ section.settings.cta_label }}
        {%- render 'fg-icon', name: 'play' -%}
      </a>
    </div>

  </div>
</section>

<style>
  .fg-symptoms {
    background-color: var(--fg-kraft);
    background-image: url('{{ 'fg-texture-kraft.jpg' | asset_url }}');
    background-size: cover;
    background-position: center;
  }
  .fg-symptoms__inner {
    max-width: 1000px;
    margin-inline: auto;
    padding: 56px var(--container-pad) 52px;
  }

  .fg-symptoms__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 370px);
    gap: 58px;
    align-items: start;
  }
  .fg-symptoms__eyebrow {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: clamp(19px, 1.6vw, 29px);
    font-weight: var(--fg-w-display);
    letter-spacing: var(--track-display);
    text-transform: uppercase;
    color: var(--fg-espresso);
  }
  .fg-symptoms__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(26px, 2.6vw, 38px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: var(--track-display);
    text-transform: uppercase;
  }
  .fg-symptoms__title-a,
  .fg-symptoms__title-b { display: block; }
  .fg-symptoms__title-a { color: var(--fg-espresso); }
  .fg-symptoms__title-b { color: var(--fg-caramel); }

  /* Speech bubble with a tail pointing back at the headline */
  .fg-symptoms__bubble {
    position: relative;
    margin: 12px 0 0;
    padding: 16px 20px;
    border: 2px solid var(--fg-espresso);
    border-radius: var(--radius-md);
    background: transparent;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.4;
    color: var(--fg-espresso);
  }
  .fg-symptoms__bubble::before,
  .fg-symptoms__bubble::after {
    content: '';
    position: absolute;
    top: 34px;
    right: 100%;
    border: 11px solid transparent;
  }
  .fg-symptoms__bubble::before { border-right-color: var(--fg-espresso); }
  .fg-symptoms__bubble::after  { border-right-color: var(--fg-kraft); margin-right: -3px; }

  .fg-symptoms__list {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    margin: 52px 0 46px;
    padding: 0;
    list-style: none;
  }
  .fg-symptoms__list li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(15px, 1.2vw, 21px);
    font-weight: var(--fg-w-display);
    line-height: 1.08;
    letter-spacing: var(--track-display);
    text-transform: uppercase;
    color: var(--fg-espresso);
  }
  .fg-symptoms__list .fg-i { width: 74px; height: 74px; }

  .fg-symptoms__foot {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .fg-symptoms__stat-lead,
  .fg-symptoms__stat-strong,
  .fg-symptoms__source { margin: 0; font-family: var(--font-body); color: var(--fg-espresso); }
  .fg-symptoms__stat-lead { font-size: clamp(16px, 1.4vw, 21px); }
  .fg-symptoms__stat-strong {
    margin-top: 4px;
    font-size: clamp(18px, 1.6vw, 24px);
    font-weight: 700;
  }
  .fg-symptoms__source { margin-top: 8px; font-size: 11px; line-height: 1.5; color: var(--fg-on-light-dim); word-break: break-all; }
  @media (pointer: coarse) { .fg-symptoms__source a { display: inline-block; padding-block: 8px; } }
  .fg-symptoms__source a { color: inherit; }
  .fg-symptoms__stat-lead sup a { color: inherit; text-decoration: none; }
  .fg-symptoms__cta { font-size: 16px; padding: 16px 32px; margin-top: 6px; }

  @media (max-width: 900px) {
    .fg-symptoms__head { grid-template-columns: 1fr; }
    .fg-symptoms__bubble::before, .fg-symptoms__bubble::after {
      top: auto; bottom: 100%; right: auto; left: 30px;
      border-right-color: transparent;
    }
    .fg-symptoms__bubble::before { border-bottom-color: var(--fg-espresso); }
    .fg-symptoms__bubble::after  { border-bottom-color: var(--fg-kraft); margin-right: 0; margin-bottom: -3px; }
    .fg-symptoms__list { grid-template-columns: repeat(3, 1fr); gap: 28px 16px; margin-block: 40px 34px; }
    .fg-symptoms__list .fg-i { width: 58px; height: 58px; }
  }
  @media (max-width: 560px) {
    .fg-symptoms__list { grid-template-columns: repeat(2, 1fr); }
    .fg-symptoms__cta { width: 100%; justify-content: center; }
  }
</style>

{% schema %}
{
  "name": "FlushGut Symptoms",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Does This Sound Like You?" },
    { "type": "text", "id": "title_a", "label": "Headline line 1", "default": "When Your Gut Is Off," },
    { "type": "text", "id": "title_b", "label": "Headline line 2", "default": "Everything Feels Off." },
    { "type": "textarea", "id": "bubble", "label": "Speech bubble",
      "default": "Your gut influences more than digestion. When it's out of balance, the effects show up everywhere — your energy, your skin, your focus, your mood." },
    { "type": "textarea", "id": "items", "label": "Symptoms", "info": "icon-name|Label",
      "default": "bloating|Persistent\nBloating,brain-fog|Brain\nFog,low-energy|Low\nEnergy,sluggish-digestion|Sluggish\nDigestion,skin-flare-ups|Skin\nFlare-Ups" },
    { "type": "text", "id": "stat_lead", "label": "Stat line",
      "default": "61% of Americans experience weekly digestive issues." },
    { "type": "text", "id": "stat_strong", "label": "Stat emphasis",
      "default": "Your Gut Controls More Than You Think." },
    { "type": "text", "id": "source_url", "label": "Source URL",
      "default": "https://europepmc.org/article/MED/30323268" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Support Your Gut Today" },
    { "type": "url", "id": "cta_url", "label": "CTA destination", "info": "Default: #fg-buy-box" }
  ],
  "presets": [{ "name": "FlushGut Symptoms" }]
}
{% endschema %}
