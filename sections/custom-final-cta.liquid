{%- comment -%}
  Closing product grid — three packshots over an oversized ghosted wordmark.

  Comp: y4030-4830 (800px) on kraft. A giant "FlushGut" fades from the top of
  the band; three cards sit over it, each with a packshot breaking above the
  card's top edge, a pack line, a name, a one-time price with Add to cart, and a
  Subscribe & Save button.

  Prices come from the assigned product, exactly as in the buy box. A card with
  no product renders its comp figures and an inert button.

  NOTE: this file previously declared a global `.fg-display` rule with no
  scoping, which leaked into every other section on the site. All selectors
  here are namespaced under .fg-close.
{%- endcomment -%}

<section class="fg-close">
  <div class="fg-close__wordmark" aria-hidden="true">{%- render 'fg-logo' -%}</div>

  <div class="fg-close__inner">
    <ul class="fg-close__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign prod = block.settings.product
          assign live = false
          assign variant_id = ''
          assign plan_id = ''
          assign one_price = block.settings.fallback_one_price
          assign sub_price = block.settings.fallback_sub_price

          if prod != blank and prod.available
            assign v = prod.selected_or_first_available_variant
            if v != blank
              assign live = true
              assign variant_id = v.id
              assign one_price = v.price | money_without_trailing_zeros
              assign alloc = v.selling_plan_allocations | first
              if alloc != blank
                assign plan_id = alloc.selling_plan.id
                assign sub_price = alloc.price | money_without_trailing_zeros
              else
                assign sub_price = one_price
              endif
            endif
          endif
        -%}
        <li class="fg-close__card{% unless live %} is-unavailable{% endunless %}" {{ block.shopify_attributes }}>
          <div class="fg-close__shot">
            <img src="{{ block.settings.image | default: block.settings.fallback_image | asset_url }}"
                 alt="{{ block.settings.name | escape }}" width="300" height="300" loading="lazy">
          </div>
          <p class="fg-close__pack">{{ block.settings.pack }}</p>
          <h3 class="fg-close__name">
            <span class="fg-close__name-brand">FlushGut</span> {{ block.settings.name }}
          </h3>

          <div class="fg-close__buy">
            <span class="fg-close__price">{{ one_price }}</span>
            {%- if live -%}
              <form method="post" action="{{ routes.cart_add_url }}" class="fg-close__form">
                <input type="hidden" name="id" value="{{ variant_id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="fg-close__atc">
                  {{ section.settings.atc_label }}
                  {%- render 'fg-icon', name: 'cart' -%}
                </button>
              </form>
            {%- else -%}
              <span class="fg-close__atc is-disabled">{{ section.settings.soon_label }}</span>
            {%- endif -%}
          </div>

          {%- if live and plan_id != blank -%}
            <form method="post" action="{{ routes.cart_add_url }}" class="fg-close__subform">
              <input type="hidden" name="id" value="{{ variant_id }}">
              <input type="hidden" name="selling_plan" value="{{ plan_id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="fg-close__sub">
                <span>{{ section.settings.sub_label }}</span>
                <strong>{{ sub_price }}</strong>
              </button>
            </form>
          {%- else -%}
            <span class="fg-close__sub is-disabled">
              <span>{{ section.settings.sub_label }}</span>
              <strong>{{ sub_price }}</strong>
            </span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .fg-close { position: relative; background: var(--fg-kraft); overflow: hidden; }

  /* Oversized wordmark, set as vector so it scales without a bitmap, faded
     from the top of the band exactly as the comp draws it. */
  .fg-close__wordmark {
    position: absolute;
    top: 26px;
    left: 50%;
    transform: translateX(-50%);
    width: min(1640px, 92vw);
    pointer-events: none;
    --fg-logo-a: var(--fg-caramel);
    --fg-logo-b: var(--fg-caramel);
    opacity: 0.42;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 34%, transparent 92%);
            mask-image: linear-gradient(180deg, #000 0%, #000 34%, transparent 92%);
  }
  .fg-close__wordmark .fg-logo__svg { width: 100%; height: auto; display: block; }

  .fg-close__inner {
    position: relative;
    max-width: 1000px;
    margin-inline: auto;
    padding: 250px var(--container-pad) 60px;
  }
  .fg-close__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fg-close__card {
    position: relative;
    margin-top: 96px;
    padding: 104px 18px 22px;
    border: 1px solid var(--fg-rule-light);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .fg-close__shot {
    position: absolute;
    top: -96px;
    left: 50%;
    transform: translateX(-50%);
    width: 190px;
  }
  .fg-close__shot img { width: 100%; height: auto; display: block; }

  .fg-close__pack {
    margin: 0 0 4px;
    font-family: var(--font-body); font-size: 14px;
    color: var(--fg-on-light-dim);
  }
  .fg-close__name {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: clamp(16px, 1.5vw, 22px);
    font-weight: 800;
    letter-spacing: var(--track-display);
    text-transform: uppercase;
    color: var(--fg-espresso);
  }
  .fg-close__name-brand { color: var(--fg-caramel-deep); }

  .fg-close__buy { display: flex; align-items: baseline; justify-content: center; gap: 14px; margin-bottom: 14px; }
  .fg-close__price {
    font-family: var(--font-display); font-size: clamp(22px, 2vw, 30px);
    font-weight: 800; letter-spacing: -0.02em; color: var(--fg-espresso);
  }
  .fg-close__form { margin: 0; }
  .fg-close__atc {
    display: inline-flex; align-items: center; gap: 6px;
    background: none; border: 0; padding: 0; cursor: pointer;
    font-family: var(--font-body); font-size: 12px; font-weight: 700;
    letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--fg-espresso); text-decoration: underline; text-underline-offset: 3px;
  }
  .fg-close__atc .fg-i { width: 15px; height: 15px; }
  .fg-close__atc.is-disabled { cursor: default; text-decoration: none; color: var(--fg-espresso); opacity: 0.85; }

  .fg-close__subform { margin: 0; }
  .fg-close__sub {
    width: 100%;
    display: flex; align-items: center; justify-content: center; gap: 12px;
    padding: 12px 16px;
    background: var(--fg-espresso); color: var(--fg-on-dark);
    border: 0; border-radius: var(--radius-sm); cursor: pointer;
    font-family: var(--font-body); font-size: 14px;
    transition: background var(--motion-base) var(--ease-out);
  }
  .fg-close__sub strong { font-size: 17px; font-weight: 800; }
  .fg-close__sub:hover { background: var(--fg-ink); }
  .fg-close__sub.is-disabled { opacity: 0.5; cursor: default; }
  .fg-close__card.is-unavailable { opacity: 0.82; }

  @media (pointer: coarse) {
    .fg-close__atc { padding-block: 15px; }
  }
  @media (max-width: 900px) {
    .fg-close__inner { padding-top: 170px; }
    .fg-close__grid { grid-template-columns: 1fr; gap: 20px; }
    .fg-close__card { margin-top: 84px; }
    .fg-close__shot { width: 160px; top: -84px; }
  }
  @media (max-width: 560px) {
    .fg-close__inner { padding-top: 120px; }
  }
</style>

{% schema %}
{
  "name": "FlushGut Closing Grid",
  "tag": "div",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "atc_label", "label": "Add to cart label", "default": "Add To Cart" },
    { "type": "text", "id": "sub_label", "label": "Subscribe label", "default": "Subscribe & Save" },
    { "type": "text", "id": "soon_label", "label": "Unavailable label", "default": "Coming Soon" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "text", "id": "name", "label": "Format name", "default": "Capsule" },
        { "type": "product", "id": "product", "label": "Product", "info": "Empty = inert Coming Soon card." },
        { "type": "text", "id": "pack", "label": "Pack line", "default": "80 Capsules / Bottle" },
        { "type": "image_picker", "id": "image", "label": "Packshot" },
        { "type": "text", "id": "fallback_image", "label": "Theme asset fallback", "info": "e.g. fg-pack-capsule.webp" },
        { "type": "header", "content": "Fallback figures" },
        { "type": "text", "id": "fallback_one_price", "label": "One-time price", "default": "$37.99" },
        { "type": "text", "id": "fallback_sub_price", "label": "Subscription price", "default": "$29.99" }
      ]
    }
  ],
  "presets": [{ "name": "FlushGut Closing Grid" }]
}
{% endschema %}
