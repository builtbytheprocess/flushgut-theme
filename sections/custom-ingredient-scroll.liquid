<style>
/* ── 03 Ingredient Scroll — self-contained styles ── */
.fg-ingr-section { position:relative; overflow:hidden; background-color:var(--fg-dark); }
.fg-overline { display:inline-flex; align-items:center; gap:8px; font-family:var(--font-body); font-size:var(--fs-label); font-weight:600; letter-spacing:var(--track-label); text-transform:uppercase; color:rgba(243,119,33,0.9); margin-bottom:20px; }
.fg-overline::before { content:''; display:block; width:24px; height:2px; background:currentColor; border-radius:1px; flex-shrink:0; }
.fg-display { font-family:var(--font-display); font-size:clamp(28px,3.5vw,52px); font-weight:800; text-transform:uppercase; letter-spacing:var(--track-display); line-height:1.05; }
.text-orange { color:var(--fg-orange); }
.fg-ingredient-card { display:flex; align-items:center; gap:20px; background:rgba(250,248,245,0.08); border:1px solid rgba(250,248,245,0.12); border-radius:var(--radius-lg); padding:20px 28px; }
.fg-ingredient-card__amount { font-family:var(--font-display); font-size:32px; font-weight:800; color:var(--fg-orange); line-height:1; white-space:nowrap; }
.fg-ingredient-card__name { font-family:var(--font-body); font-size:15px; font-weight:400; color:var(--fg-canvas); opacity:0.85; line-height:1.4; }

/* Full-width headline above the grid */
.fg-ingr-header { padding:60px 48px 40px; max-width:var(--container-max); margin:0 auto; width:100%; }

/* Two-column grid: image left, cards right */
.fg-ingr-outer {
  display: grid;
  grid-template-columns: 48% 1fr;
  min-height: 55vh;
  align-items: stretch;
}
.fg-ingr-img-col {
  position: relative;
  overflow: hidden;
}
.fg-ingr-img-col img {
  position: absolute;
  bottom: -45px;
  left: 0;
  width: 100%;
  height: auto;
  display: block;
}
.fg-ingr-cards-col {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 20px;
  padding: 0 48px 60px 40px;
}

/* Mobile: H2 → image → cards (natural DOM order) */
@media(max-width:900px) {
  .fg-ingr-header { padding:40px 24px 24px; }
  .fg-ingr-outer { grid-template-columns:1fr; min-height:auto; }
  .fg-ingr-img-col {
    height: 55vw;
    max-height: 280px;
    overflow: hidden;
    position: relative;
  }
  .fg-ingr-img-col img {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: auto;
    height: 100%;
  }
  .fg-ingr-cards-col { padding:24px 24px 40px; gap:16px; }
}
</style>

<section class="fg-ingr-section bg-dark" id="fg-ingredient-section" data-nav-theme="dark">

  <!-- H2 spans full width above both columns — always first -->
  <div class="fg-ingr-header">
    <p class="fg-overline">What&rsquo;s inside</p>
    <h2 class="fg-display" style="color:white;margin:0;">
      22 ACTIVE<br>
      <span class="text-orange">INGREDIENTS.</span><br>
      ONE JELLY STICK.
    </h2>
  </div>

  <div class="fg-ingr-outer">

    <!-- Left: image anchored to bottom, wrist from edge -->
    <div class="fg-ingr-img-col">
      <img src="{{ 'fg-back-box.png' | asset_url }}"
           alt="Back of FlushGut box — supplement facts"
           loading="lazy">
    </div>

    <!-- Right: ingredient cards -->
    <div class="fg-ingr-cards-col">

      <div class="fg-ingredient-card" data-aos="fade-left" data-aos-delay="0">
        <span class="fg-ingredient-card__amount">7.5g</span>
        <div>
          <div class="fg-ingredient-card__name" style="font-weight:600;font-size:17px;margin-bottom:4px;">Prebiotic Fiber Blend</div>
          <div class="fg-ingredient-card__name" style="font-size:13px;opacity:0.6;">Supports gut bacteria + daily regularity</div>
        </div>
      </div>

      <div class="fg-ingredient-card" data-aos="fade-left" data-aos-delay="80">
        <span class="fg-ingredient-card__amount">4.3g</span>
        <div>
          <div class="fg-ingredient-card__name" style="font-weight:600;font-size:17px;margin-bottom:4px;">Fruit, Vegetable &amp; Kelp Blend</div>
          <div class="fg-ingredient-card__name" style="font-size:13px;opacity:0.6;">Antioxidants + mineral support</div>
        </div>
      </div>

      <div class="fg-ingredient-card" data-aos="fade-left" data-aos-delay="160">
        <span class="fg-ingredient-card__amount">500mg</span>
        <div>
          <div class="fg-ingredient-card__name" style="font-weight:600;font-size:17px;margin-bottom:4px;">L-Carnitine L-Tartrate</div>
          <div class="fg-ingredient-card__name" style="font-size:13px;opacity:0.6;">Energy metabolism support</div>
        </div>
      </div>

      <div class="fg-ingredient-card" data-aos="fade-left" data-aos-delay="240">
        <span class="fg-ingredient-card__amount">510M</span>
        <div>
          <div class="fg-ingredient-card__name" style="font-weight:600;font-size:17px;margin-bottom:4px;">CFU Bacillus coagulans</div>
          <div class="fg-ingredient-card__name" style="font-size:13px;opacity:0.6;">Shelf-stable probiotic strain</div>
        </div>
      </div>

      <div style="margin-top:8px;">
        <a href="/ingredients/"
           style="color:rgba(250,248,245,0.55);font-family:var(--font-body);font-size:14px;font-weight:500;letter-spacing:0.04em;text-decoration:none;border-bottom:1px solid rgba(250,248,245,0.2);padding-bottom:2px;transition:color 150ms,border-color 150ms;"
           onmouseover="this.style.color='var(--fg-orange)';this.style.borderColor='var(--fg-orange)';"
           onmouseout="this.style.color='rgba(250,248,245,0.55)';this.style.borderColor='rgba(250,248,245,0.2)';">
          View all 22 ingredients &rarr;
        </a>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredient Scroll",
  "tag": "section",
  "class": "fg-ingr-section",
  "presets": [{ "name": "Ingredient Scroll" }]
}
{% endschema %}
