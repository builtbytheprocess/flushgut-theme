{%- comment -%}
  "The real reason fiber works — explained." Doctor band.

  Replaces custom-ingredient-science.liquid. Comp: y3028-3430 (402px). The
  office still runs full-bleed with the copy set on the right half: eyebrow
  17.9px @ y3065, a three-line headline (35.6/35.6/41.4px) @ x1035, body copy
  20px, then a byline with a circular headshot @ y3338.

  If a video URL is set the still becomes a play trigger; otherwise it is a
  plain image, which is how it ships until the film exists.
{%- endcomment -%}

<section class="fg-doctor">
  <div class="fg-doctor__inner">
    <div class="fg-doctor__copy">
      <p class="fg-doctor__eyebrow"><span></span>{{ section.settings.eyebrow }}<span></span></p>

      <h2 class="fg-doctor__title">
        <span class="fg-doctor__title-a">{{ section.settings.title_a | newline_to_br }}</span>
        <span class="fg-doctor__title-b">{{ section.settings.title_b }}</span>
      </h2>

      <p class="fg-doctor__body">{{ section.settings.body }}</p>

      <div class="fg-doctor__byline">
        {%- if section.settings.headshot != blank -%}
          <img src="{{ section.settings.headshot | image_url: width: 200 }}"
               alt="{{ section.settings.name | escape }}" width="64" height="64" loading="lazy">
        {%- else -%}
          <img src="{{ 'fg-doctor-stein.webp' | asset_url }}"
               alt="{{ section.settings.name | escape }}" width="64" height="64" loading="lazy">
        {%- endif -%}
        <div>
          <p class="fg-doctor__name">{{ section.settings.name }}</p>
          <p class="fg-doctor__role">{{ section.settings.role }}</p>
        </div>
      </div>

      {%- if section.settings.video_url != blank -%}
        <a class="fg-btn fg-doctor__play" href="{{ section.settings.video_url }}"
           target="_blank" rel="noopener">
          {{ section.settings.play_label }}
          {%- render 'fg-icon', name: 'play' -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .fg-doctor {
    position: relative;
    background-color: var(--fg-caramel);
    background-image: url('{{ 'fg-doctor-still.jpg' | asset_url }}');
    background-size: cover;
    background-position: center left;
  }
  /* The copy column sits on the photograph itself, so its contrast depended on
     the image behind it — cream on the bare caramel fallback only reached
     3.25:1. This scrim darkens the right side so every line clears WCAG AA
     regardless of what the photo is doing, while leaving the doctor and the
     monitor on the left untouched. */
  .fg-doctor::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg,
      rgba(41, 25, 5, 0) 0%,
      rgba(41, 25, 5, 0.10) 34%,
      rgba(41, 25, 5, 0.72) 60%,
      rgba(41, 25, 5, 0.82) 100%);
  }
  .fg-doctor__inner {
    position: relative;
    z-index: 1;
    max-width: 1000px;
    margin-inline: auto;
    min-height: 402px;
    padding: 40px var(--container-pad);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 470px);
  }
  .fg-doctor__copy { grid-column: 2; align-self: center; }

  .fg-doctor__eyebrow {
    display: flex; align-items: center; gap: 12px;
    margin: 0 0 10px;
    font-family: var(--font-body);
    font-size: 13px; font-weight: var(--fg-w-bold);
    letter-spacing: var(--track-label); text-transform: uppercase;
    color: var(--fg-cream);
  }
  .fg-doctor__eyebrow span { flex: 1 1 auto; height: 1px; background: var(--fg-cream); opacity: 0.6; max-width: 34px; }

  .fg-doctor__title {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: var(--track-display);
    text-transform: uppercase;
  }
  .fg-doctor__title-a { display: block; font-size: clamp(24px, 2.4vw, 36px); color: var(--fg-cream); }
  .fg-doctor__title-b { display: block; font-size: clamp(27px, 2.8vw, 41px); color: var(--fg-caramel-light); }

  .fg-doctor__body {
    margin: 0 0 22px;
    max-width: 44ch;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.45;
    color: var(--fg-cream);
  }

  .fg-doctor__byline { display: flex; align-items: center; gap: 14px; }
  .fg-doctor__byline img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; }
  .fg-doctor__name,
  .fg-doctor__role { margin: 0; font-family: var(--font-body); line-height: 1.3; }
  .fg-doctor__name { font-size: 17px; font-weight: 700; color: var(--fg-cream); }
  .fg-doctor__role { font-size: 14px; color: var(--fg-cream); }

  .fg-doctor__play { margin-top: 22px; }

  @media (max-width: 1000px) {
    .fg-doctor { background-position: 30% center; }
    .fg-doctor__inner { grid-template-columns: 1fr; min-height: 0; padding-block: 220px 44px; }
    .fg-doctor__copy { grid-column: 1; }
    .fg-doctor__body { max-width: none; }
  }
</style>

{% schema %}
{
  "name": "FlushGut Doctor",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Doctor-Led Science-First" },
    { "type": "textarea", "id": "title_a", "label": "Headline lines 1-2", "default": "The real reason\nfiber works" },
    { "type": "text", "id": "title_b", "label": "Headline line 3", "default": "Explained." },
    { "type": "textarea", "id": "body", "label": "Body",
      "default": "Board-certified gastroenterologist Dr. Ralph Stein explains why most people aren't getting enough fiber, and what actually happens in your gut when you do." },
    { "type": "image_picker", "id": "headshot", "label": "Headshot", "info": "Defaults to the comp image." },
    { "type": "text", "id": "name", "label": "Name", "default": "Dr. Ralph Stein" },
    { "type": "text", "id": "role", "label": "Role", "default": "Board-Certified Gastroenterologist" },
    { "type": "url", "id": "video_url", "label": "Video URL", "info": "Adds a play button when set." },
    { "type": "text", "id": "play_label", "label": "Play button label", "default": "Watch the explainer" }
  ],
  "presets": [{ "name": "FlushGut Doctor" }]
}
{% endschema %}
