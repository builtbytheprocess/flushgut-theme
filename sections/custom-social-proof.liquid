<style>
/* ── hp-05 Dr. Stein Video ── self-contained ── */
.fg-container { max-width:var(--container-max); margin:0 auto; padding:0 var(--container-pad); }
.fg-section { padding-block:var(--sp-section); }
.bg-dark { background-color:var(--fg-dark); color:var(--fg-canvas); }
.hp-video__overline { display:inline-flex; align-items:center; gap:8px; font-family:var(--font-body); font-size:var(--fs-label); font-weight:600; letter-spacing:var(--track-label); text-transform:uppercase; color:rgba(243,119,33,0.9); margin-bottom:20px; }
.hp-video__overline::before { content:''; display:block; width:24px; height:2px; background:currentColor; border-radius:1px; flex-shrink:0; }
.hp-video__grid { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center; }
.hp-video__headline { font-family:var(--font-display); font-size:var(--fs-h2); font-weight:800; text-transform:uppercase; letter-spacing:-0.01em; line-height:1.05; color:#fff; margin:0 0 16px; }
.hp-video__headline em { color:var(--fg-orange); font-style:normal; }
.hp-video__copy { font-family:var(--font-body); font-size:17px; font-weight:300; line-height:1.65; color:rgba(250,248,245,0.75); margin:0 0 28px; }
.hp-video__creds { display:flex; align-items:center; gap:16px; }
.hp-video__doctor-img { width:64px; height:64px; border-radius:50%; object-fit:cover; flex-shrink:0; border:2px solid rgba(243,119,33,0.4); }
.hp-video__doctor-name { font-family:var(--font-body); font-size:15px; font-weight:600; color:#fff; margin:0 0 2px; }
.hp-video__doctor-title { font-family:var(--font-body); font-size:13px; color:rgba(250,248,245,0.55); margin:0; }
.hp-video__embed { border-radius:var(--radius-lg); overflow:hidden; aspect-ratio:16/9; background:#000; }
.hp-video__embed iframe { width:100%; height:100%; border:none; display:block; }
@media (max-width:900px) { .hp-video__grid { grid-template-columns:1fr; gap:40px; } }
</style>

<!-- ============================================================
     hp-05 — DR. STEIN VIDEO
     Background: --fg-dark (continuation from ingredients)
     NOTE: VIDEO_EMBED_URL is a placeholder — no embed found on /home-new-copy/.
     Replace with actual YouTube/Vimeo embed src when available.
     ============================================================ -->

<section class="fg-section bg-dark" data-nav-theme="dark">
  <div class="fg-container">
    <div class="hp-video__grid">

      <div data-aos="fade-right">
        <p class="hp-video__overline">Doctor-led. Science-first.</p>
        <h2 class="hp-video__headline">
          The real reason<br>fiber works &mdash;<br>
          <em>explained.</em>
        </h2>
        <p class="hp-video__copy">
          Board-certified gastroenterologist Dr. Ralph Stein explains why most people aren&rsquo;t getting enough fiber &mdash; and what actually happens in your gut when you do.
        </p>
        <div class="hp-video__creds">
          <img class="hp-video__doctor-img"
               src="{{ 'fg-dr-bubble.png' | asset_url }}"
               alt="Dr. Ralph Stein" loading="lazy">
          <div>
            <p class="hp-video__doctor-name">Dr. Ralph Stein</p>
            <p class="hp-video__doctor-title">Board-Certified Gastroenterologist</p>
          </div>
        </div>
      </div>

      <div class="hp-video__embed" data-aos="fade-left" data-aos-delay="80">
        <img src="{{ 'fg-dr-explaining.png' | asset_url }}"
             alt="Dr. Ralph Stein explaining how fiber works and gut health"
             style="width:100%;height:100%;object-fit:cover;display:block;"
             loading="lazy">
      </div>

    </div>
  </div>
</section>
<style>
/* ── hp-06 Testimonials ── self-contained ── */
.fg-container { max-width:var(--container-max); margin:0 auto; padding:0 var(--container-pad); }
.fg-section { padding-block:var(--sp-section); }
.bg-canvas { background-color:var(--fg-canvas); color:var(--fg-ink); }
.hp-testi__overline { display:inline-flex; align-items:center; gap:8px; font-family:var(--font-body); font-size:var(--fs-label); font-weight:600; letter-spacing:var(--track-label); text-transform:uppercase; color:var(--fg-orange); margin-bottom:20px; }
.hp-testi__overline::before { content:''; display:block; width:24px; height:2px; background:currentColor; border-radius:1px; flex-shrink:0; }
.hp-testi__header { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:56px; flex-wrap:wrap; gap:24px; }
.hp-testi__headline { font-family:var(--font-display); font-size:var(--fs-h1); font-weight:800; text-transform:uppercase; letter-spacing:-0.02em; line-height:1.05; color:var(--fg-ink); margin:0; }
.hp-testi__headline em { color:var(--fg-orange); font-style:normal; }
.hp-testi__rating { display:flex; align-items:center; gap:12px; padding-bottom:8px; }
.hp-testi__stars { color:var(--fg-orange); font-size:18px; letter-spacing:2px; }
.hp-testi__score { font-family:var(--font-display); font-size:32px; font-weight:800; color:var(--fg-ink); }
.hp-testi__count { font-family:var(--font-body); font-size:14px; color:var(--fg-muted); }
.hp-testi__grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; align-items:start; }
.hp-testi__card { background:#fff; border-radius:var(--radius-lg); border:1px solid var(--fg-border); padding:28px; display:flex; flex-direction:column; gap:20px; box-shadow:var(--shadow-card); }
.hp-testi__card-stars { color:var(--fg-orange); font-size:13px; letter-spacing:2px; }
.hp-testi__quote { font-family:var(--font-editorial); font-style:italic; font-size:17px; line-height:1.65; color:var(--fg-ink); margin:0; flex:1; }
.hp-testi__meta { display:flex; align-items:center; gap:12px; }
.hp-testi__avatar { width:44px; height:44px; border-radius:50%; object-fit:cover; flex-shrink:0; }
.hp-testi__name { font-family:var(--font-body); font-size:14px; font-weight:600; color:var(--fg-ink); margin:0 0 2px; }
.hp-testi__tag { font-family:var(--font-body); font-size:12px; color:var(--fg-muted); margin:0; }
@media (max-width:900px) { .hp-testi__grid { grid-template-columns:1fr; } }
</style>

